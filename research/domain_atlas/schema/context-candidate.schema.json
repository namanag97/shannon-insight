{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/context-candidate-v0.1.0.schema.json",
  "title": "Bounded-context candidate record",
  "type": "object",
  "required": [
    "record_id",
    "record_kind",
    "edition",
    "status",
    "family_id",
    "seed_term",
    "name",
    "review_priority",
    "adjudication",
    "coverage",
    "gaps"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^candidate\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "record_kind": {"const": "bounded_context_candidate"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"enum": ["enumerated", "researching", "specified", "adjudicated", "rejected", "merged", "split"]},
    "family_id": {"type": "string", "minLength": 1},
    "seed_term": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "review_priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "ambiguity_status": {"enum": ["none", "declared"]},
    "adjudication": {"enum": ["unreviewed", "retain", "merge", "split", "rehome", "reject"]},
    "sovereign_question": {"type": ["string", "null"]},
    "coverage": {
      "type": "object",
      "required": ["research", "strategic_ddd", "tactical_ddd", "semantic_laws", "authority_time_failure", "contracts_context_map", "compiler_runtime", "independent_review"],
      "additionalProperties": false,
      "properties": {
        "research": {"$ref": "#/$defs/coverage"},
        "strategic_ddd": {"$ref": "#/$defs/coverage"},
        "tactical_ddd": {"$ref": "#/$defs/coverage"},
        "semantic_laws": {"$ref": "#/$defs/coverage"},
        "authority_time_failure": {"$ref": "#/$defs/coverage"},
        "contracts_context_map": {"$ref": "#/$defs/coverage"},
        "compiler_runtime": {"$ref": "#/$defs/coverage"},
        "independent_review": {"$ref": "#/$defs/coverage"}
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "deep_spec_ref": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "coverage": {"enum": ["none", "partial", "complete_unverified", "verified"]}
  },
  "additionalProperties": false
}
