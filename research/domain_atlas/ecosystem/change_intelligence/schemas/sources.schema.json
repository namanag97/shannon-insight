{
  "$id": "https://shannon.invalid/domain-atlas/change-intelligence/sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_tier": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_url": {
      "format": "uri",
      "minLength": 1,
      "type": "string"
    },
    "content_digest": {
      "type": "null"
    },
    "coverage_plane_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "digest_posture": {
      "minLength": 1,
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "proof_obligation_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "retrieved_at": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_kind": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "authority_tier",
    "canonical_url",
    "content_digest",
    "coverage_plane_ids",
    "digest_posture",
    "limitations",
    "proof_obligation_ids",
    "publisher",
    "retrieved_at",
    "source_id",
    "source_kind",
    "title"
  ],
  "title": "sources",
  "type": "object"
}
