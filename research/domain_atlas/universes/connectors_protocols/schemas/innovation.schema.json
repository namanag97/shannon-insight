{
  "$id": "https://san.example/domain-atlas/connectors-protocols/innovation_id.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change": {
      "minLength": 15,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "innovation_id": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "non_llm": {
      "const": true
    },
    "protocol_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "hypothesis",
        "test_fixture",
        "deprecated_candidate",
        "open"
      ]
    },
    "why_material": {
      "minLength": 15,
      "type": "string"
    },
    "year": {
      "maximum": 2026,
      "minimum": 2021,
      "type": "integer"
    }
  },
  "required": [
    "innovation_id",
    "edition",
    "status",
    "name",
    "year",
    "change",
    "why_material",
    "non_llm",
    "protocol_refs",
    "evidence_refs",
    "limitations"
  ],
  "title": "Recent non-LLM connector/protocol innovation",
  "type": "object"
}
