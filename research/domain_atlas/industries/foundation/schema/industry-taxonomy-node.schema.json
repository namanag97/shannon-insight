{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/industry-taxonomy-node-v1.schema.json",
  "title": "Edition-frozen industry taxonomy node",
  "type": "object",
  "required": [
    "record_id",
    "record_kind",
    "edition",
    "status",
    "scheme_id",
    "scheme_edition_id",
    "scheme_code",
    "level",
    "level_ordinal",
    "title",
    "parent_id",
    "ancestor_ids",
    "child_count",
    "is_leaf",
    "concept_kind",
    "taxonomy_role",
    "semantic_identity_policy",
    "assignment_basis",
    "source_refs",
    "source_locator",
    "source_sha256"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^industry\\.isic5\\.(section\\.[a-v]|(division|group|class)\\.c[0-9]{2,4})$"},
    "record_kind": {"const": "industry_taxonomy_node"},
    "edition": {"const": 1},
    "status": {"const": "official_import"},
    "scheme_id": {"const": "scheme.un.isic"},
    "scheme_edition_id": {"const": "scheme.un.isic.rev5"},
    "scheme_code": {"type": "string", "pattern": "^(?:[A-V]|[0-9]{2,4})$"},
    "level": {"enum": ["section", "division", "group", "class"]},
    "level_ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
    "title": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]},
    "ancestor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "child_count": {"type": "integer", "minimum": 0},
    "is_leaf": {"type": "boolean"},
    "concept_kind": {"const": "economic_activity"},
    "taxonomy_role": {"const": "global_activity_reference_spine"},
    "semantic_identity_policy": {"const": "edition_frozen_boundary"},
    "assignment_basis": {"const": "principal_economic_activity_under_scheme_rules"},
    "source_refs": {"const": ["source.un.isic.rev5.structure"]},
    "source_locator": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
