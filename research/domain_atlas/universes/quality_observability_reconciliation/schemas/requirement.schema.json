{
  "$id": "https://shannon-insight.local/schemas/qor/requirement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptable_effects": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "edition": {
      "type": "integer"
    },
    "intent_kind": {
      "minLength": 1,
      "type": "string"
    },
    "owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "proof_obligations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "requirement_id": {
      "pattern": "^qor\\.requirement\\.",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^qor\\.src\\.",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "researched_candidate_not_adjudicated"
    },
    "unresolved_behavior": {
      "const": "refuse_with_typed_gap"
    }
  },
  "required": [
    "requirement_id",
    "edition",
    "status",
    "intent_kind",
    "owner_context",
    "required_capabilities",
    "required_decisions",
    "proof_obligations",
    "acceptable_effects",
    "unresolved_behavior",
    "source_refs"
  ],
  "title": "Quality intent requirement candidate",
  "type": "object"
}
