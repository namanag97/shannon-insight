{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://san.example/domain-atlas/access-surface.schema.json",
  "title":"Observed access surface on a source occurrence",
  "description":"Binds one concrete deployed occurrence to one observed protocol/export/query/change surface. This is not the provider offer and not the connector implementation.",
  "type":"object",
  "additionalProperties":false,
  "required":["surface_id","occurrence_ref","surface_kind","protocol_or_format","endpoint_or_locator_class","object_scope","read_modes","change_modes","authority_scope","observed_limits","security_requirements","observed_at","expires_at","evidence_refs","status","non_collapse"],
  "properties":{
    "surface_id":{"type":"string","pattern":"^source-surface\\."},
    "occurrence_ref":{"type":"string","pattern":"^source-occurrence\\."},
    "surface_kind":{"enum":["database","query_endpoint","api","odata","graphql","soap","rpc","bulk_export","file_export","object_store","change_log","cdc","event_log","queue","webhook","document_api","telemetry","industrial_protocol","other_typed"]},
    "protocol_or_format":{"type":"string","minLength":1},
    "endpoint_or_locator_class":{"type":"string","minLength":1},
    "object_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "read_modes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "change_modes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "authority_scope":{"type":"string","minLength":1},
    "observed_limits":{"type":"object","minProperties":1},
    "security_requirements":{"type":"object","minProperties":1},
    "observed_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "status":{"enum":["OBSERVED","INCONCLUSIVE","REVOKED","EXPIRED"]},
    "non_collapse":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string"}},
    "completion_claim":{"type":"boolean","const":false}
  }
}
