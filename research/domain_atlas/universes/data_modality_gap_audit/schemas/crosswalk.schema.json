{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/data-modality-gap-audit/crosswalk.schema.json",
  "type": "object",
  "required": ["crosswalk_id", "family_id", "target_registry", "target_kind", "target_id", "relation", "comparison_basis", "law_comparison", "equivalence_justification", "name_equivalence_used", "rationale", "evidence_refs", "status"],
  "properties": {
    "crosswalk_id": {"type": "string", "pattern": "^cw\\.[0-9]{3}$"},
    "family_id": {"type": "string", "pattern": "^fam\\."},
    "target_registry": {"const": "san.domain-atlas.data-shapes"},
    "target_kind": {"enum": ["shape_record", "type_record", "none"]},
    "target_id": {"type": ["string", "null"]},
    "relation": {"enum": ["equivalent", "narrower", "broader", "overlap", "disjoint", "missing"]},
    "comparison_basis": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "law_comparison": {
      "type": "object",
      "required": ["abstraction_layer", "grain_identity", "topology", "order_time_change", "operation_refusals", "conclusion"],
      "properties": {
        "abstraction_layer": {"type": "string"},
        "grain_identity": {"type": "string"},
        "topology": {"type": "string"},
        "order_time_change": {"type": "string"},
        "operation_refusals": {"type": "string"},
        "conclusion": {"enum": ["equivalent", "narrower", "broader", "overlap", "disjoint", "missing"]}
      },
      "additionalProperties": false
    },
    "equivalence_justification": {"type": ["string", "null"]},
    "name_equivalence_used": {"const": false},
    "rationale": {"type": "string", "minLength": 15},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"const": "candidate_manual_law_comparison"}
  },
  "additionalProperties": false
}
