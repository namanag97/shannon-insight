{
  "$id": "https://san.local/domain-atlas/security-privacy-trust/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_scope": {
      "minLength": 1,
      "type": "string"
    },
    "cross_platform_map": {
      "additionalProperties": false,
      "properties": {
        "consumption": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "governance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "persistence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pipelines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "runtime": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_occurrences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "types_shapes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "source_occurrences",
        "types_shapes",
        "pipelines",
        "persistence",
        "runtime",
        "governance",
        "lineage",
        "consumption"
      ],
      "type": "object"
    },
    "domain": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "event_time": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_id": {
      "minLength": 3,
      "type": "string"
    },
    "evidence_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "freshness": {
      "minLength": 1,
      "type": "string"
    },
    "integrity": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "producer_identity": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "sourced_candidate",
        "open_candidate_gap"
      ],
      "type": "string"
    },
    "subject_identity": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "claim_scope",
    "cross_platform_map",
    "domain",
    "edition",
    "event_time",
    "evidence_id",
    "evidence_source_ids",
    "freshness",
    "integrity",
    "limitations",
    "producer_identity",
    "status",
    "subject_identity"
  ],
  "title": "Security Privacy Trust evidence candidate",
  "type": "object"
}
