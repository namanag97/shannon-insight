{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shannon-insight.local/schemas/horizontal-product-families-v1.json",
  "title": "Horizontal analytics product-family research corpus",
  "type": "object",
  "required": ["metadata", "product_families", "organizations", "research", "cross_family_laws", "required_cross_family_seams", "review"],
  "properties": {
    "metadata": {"type": "object", "required": ["schema_version", "created_at", "as_of", "scope", "claim_policy", "coverage_gates"]},
    "product_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/family"}},
    "organizations": {"type": "array", "items": {"$ref": "#/$defs/org"}},
    "research": {"type": "array", "items": {"$ref": "#/$defs/research"}},
    "cross_family_laws": {"type": "array", "items": {"type": "string"}},
    "required_cross_family_seams": {"type": "array", "items": {"$ref": "#/$defs/seam"}},
    "review": {"type": "object"}
  },
  "$defs": {
    "family": {
      "type": "object",
      "required": ["id", "name", "sovereign_question", "negative_charter", "organization_ids", "research_ids", "coverage", "required_product_surfaces"],
      "properties": {
        "id": {"type": "string", "pattern": "^hpf_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 3},
        "sovereign_question": {"type": "string", "minLength": 20},
        "negative_charter": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "organization_ids": {"type": "array", "minItems": 25, "uniqueItems": true, "items": {"type": "string", "pattern": "^org_[a-z0-9_]+$"}},
        "research_ids": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^ref_[a-z0-9_]+$"}},
        "coverage": {"type": "object", "required": ["organization_floor", "organization_count", "company_floor", "company_count", "research_floor", "research_count", "status"]},
        "required_product_surfaces": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "org": {
      "type": "object",
      "required": ["id", "name", "url", "organization_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^org_[a-z0-9_]+$"},
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "organization_kind": {"enum": ["company", "nonprofit_project"]}
      }
    },
    "research": {
      "type": "object",
      "required": ["id", "title", "url", "kind", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^ref_[a-z0-9_]+$"},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "kind": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "seam": {
      "type": "object",
      "required": ["from", "to", "contract"],
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "contract": {"type": "string"}}
    }
  }
}
