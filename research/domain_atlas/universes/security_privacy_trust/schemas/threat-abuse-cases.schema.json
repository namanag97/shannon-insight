{
  "$id": "https://san.local/domain-atlas/security-privacy-trust/threat-abuse-cases.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "abuse_flow": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "actor_model": {
      "minLength": 1,
      "type": "string"
    },
    "asset_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "cross_platform_map": {
      "additionalProperties": false,
      "properties": {
        "consumption": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "governance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "persistence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pipelines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "runtime": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_occurrences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "types_shapes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "source_occurrences",
        "types_shapes",
        "pipelines",
        "persistence",
        "runtime",
        "governance",
        "lineage",
        "consumption"
      ],
      "type": "object"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "impact": {
      "minLength": 1,
      "type": "string"
    },
    "mitigation_classes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "precondition": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "sourced_candidate",
        "open_candidate_gap"
      ],
      "type": "string"
    },
    "threat_id": {
      "minLength": 3,
      "type": "string"
    },
    "threat_kind": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "abuse_flow",
    "actor_model",
    "asset_refs",
    "cross_platform_map",
    "edition",
    "evidence_source_ids",
    "impact",
    "mitigation_classes",
    "name",
    "owner_context",
    "precondition",
    "status",
    "threat_id",
    "threat_kind"
  ],
  "title": "Security Privacy Trust threat-abuse-cases candidate",
  "type": "object"
}
