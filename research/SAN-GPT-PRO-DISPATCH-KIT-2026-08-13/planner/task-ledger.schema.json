{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/domain-program-task-ledger-v0.1.0.json",
  "title": "SAN domain-program task record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_kind",
    "subject_id",
    "subject_name",
    "authority_posture",
    "architecture_disposition",
    "current_gate",
    "stages",
    "dependencies",
    "evidence_refs",
    "open_issues",
    "next_admissible_action"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_kind": {
      "enum": ["program_gate", "domain_family", "bounded_context", "library_family", "proof_vertical"]
    },
    "subject_id": {"type": "string", "minLength": 1},
    "subject_name": {"type": "string", "minLength": 1},
    "source_edition": {"type": ["string", "null"]},
    "source_status": {"type": ["string", "null"]},
    "authority_posture": {
      "enum": [
        "hypothesis", "discovered_candidate", "source_supported", "boundary_qualified",
        "adjudicated", "specified", "implemented", "structurally_verified",
        "semantically_verified", "compiler_integrated", "runtime_observed",
        "independently_audited", "ratified", "certified", "rejected", "superseded"
      ]
    },
    "architecture_disposition": {
      "enum": [
        "unresolved", "semantic_library_family", "effect_or_mechanism_library",
        "interface_or_contract_only", "profile", "composition_or_card",
        "application_or_product_package", "provider_adapter", "compiler_or_tooling_unit",
        "research_only", "reject"
      ]
    },
    "current_gate": {"$ref": "#/$defs/stageName"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "required_evidence"],
        "properties": {
          "name": {"$ref": "#/$defs/stageName"},
          "state": {"enum": ["not_started", "ready", "in_progress", "complete", "deferred", "blocked", "rejected", "not_applicable"]},
          "required_evidence": {"type": "array", "items": {"type": "string"}},
          "result_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "open_issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "target_id"],
        "properties": {
          "relation": {"enum": ["same_as", "split_into", "merged_into", "superseded_by", "derived_from", "rejects"]},
          "target_id": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "next_admissible_action": {"type": "string", "minLength": 1},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "stageName": {
      "enum": [
        "research_intake", "evidence_review", "boundary_adjudication", "atlas_acceptance",
        "domain_forge", "domain_audit", "architecture_disposition", "library_forge",
        "library_audit", "reference_implementation", "conformance",
        "registry_admission", "compiler_contribution", "portable_closure",
        "target_lowering", "runtime_provider_binding", "vertical_proof",
        "independent_audit", "ratification"
      ]
    }
  }
}
