{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/data-modality-gap-audit/source.schema.json",
  "type": "object",
  "required": ["source_id", "title", "publisher", "url", "authority", "source_kind", "accessed_at", "supports", "limitations", "standard_family", "publication_year"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^A-(DSS|SRC)-[0-9]{3}$"},
    "canonical_source_id": {"type": "string", "pattern": "^DSS-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "publisher": {"type": "string", "minLength": 2},
    "url": {"type": "string", "pattern": "^https://"},
    "publication_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2026},
    "standard_family": {"type": "string"},
    "edition_or_version": {"type": ["string", "null"]},
    "authority": {"type": "string"},
    "source_kind": {"type": "string"},
    "accessed_at": {"type": "string", "format": "date"},
    "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
