{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact_id", "title", "artifact_kind", "year", "direct_url", "authors", "evidence_scope", "claim_state", "limitations"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^artifact\\.[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 2},
    "artifact_kind": {"type": "string"},
    "year": {"type": ["integer", "null"], "maximum": 2026},
    "direct_url": {"type": "string", "pattern": "^https://"},
    "authors": {"type": "array", "minItems": 1},
    "evidence_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claim_state": {"type": "string"},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
