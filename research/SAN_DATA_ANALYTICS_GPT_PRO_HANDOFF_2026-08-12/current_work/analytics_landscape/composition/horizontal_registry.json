{
  "model_version": "1.0.0",
  "kind": "horizontal_registry",
  "boundary_rule": "Machines may use canonical roles only; industry nouns belong in domain packs.",
  "canonical_types": ["raw_record", "contracted_record", "entity", "event", "observation", "interval", "time_series", "relation", "spatial_feature", "metric_value", "finding", "decision", "action", "query", "plan", "model", "distribution", "artifact"],
  "libraries": [
    {"id":"lib.contracts","owns":"schemas, compatibility, validation","machines":["machine.contract_validate","machine.unit_normalize","machine.identity_resolve"]},
    {"id":"lib.temporal","owns":"event time, windows, state and time series","machines":["machine.event_order","machine.window","machine.state_reconstruct","machine.forecast"]},
    {"id":"lib.relational","owns":"deterministic relational transforms","machines":["machine.join","machine.aggregate","machine.segment"]},
    {"id":"lib.diagnostics","owns":"comparison and explanatory evidence","machines":["machine.variance","machine.change_detect","machine.root_cause","machine.process_conformance"]},
    {"id":"lib.decisions","owns":"causal, simulation and optimization solvers","machines":["machine.experiment_measure","machine.simulate","machine.optimize"]},
    {"id":"lib.spatial_network","owns":"spatial and graph operations","machines":["machine.spatial_join","machine.network_measure"]},
    {"id":"lib.delivery","owns":"metrics, alerts, reports and action delivery","machines":["machine.metric_compute","machine.alert_evaluate","machine.publish"]},
    {"id":"lib.control","owns":"policy, provenance, quality, cost and observability","machines":["machine.policy_enforce","machine.quality_test","machine.lineage_record","machine.cost_meter"]},
    {"id":"lib.connectors","owns":"source capture, destination delivery and reconciliation semantics","machines":["machine.source_capture","machine.destination_deliver","machine.delivery_reconcile"]},
    {"id":"lib.execution","owns":"portable plans, batch/stream execution, state, checkpoint and recovery","machines":["machine.relational_execute","machine.stream_execute","machine.build_execute"]},
    {"id":"lib.econometrics","owns":"regression, elasticity, quasi-experimental and response-curve estimation","machines":["machine.regression_fit","machine.quasi_estimate","machine.response_curve"]},
    {"id":"lib.reliability_risk","owns":"survival, frequency/severity, reserves and stress calculations","machines":["machine.survival_fit","machine.frequency_severity","machine.reserve_estimate","machine.stress_test"]},
    {"id":"lib.privacy_compute","owns":"contribution bounding, privacy accounting and controlled multi-party release","machines":["machine.contribution_bound","machine.private_release","machine.cleanroom_execute"]},
    {"id":"lib.interaction","owns":"interaction capture/replay, visual encoding and human adjudication","machines":["machine.interaction_capture","machine.interaction_replay","machine.visual_encode","machine.human_review"]},
    {"id":"lib.process_projection","owns":"trace/object projection and process discovery","machines":["machine.trace_project","machine.object_event_project","machine.process_discover"]},
    {"id":"lib.semantic_serving","owns":"semantic planning, materialization, query serving and reactive application state","machines":["machine.semantic_plan","machine.materialize","machine.query_serve","machine.reactive_state"]}
  ],
  "machines": [
    {"id":"machine.contract_validate","layer":"ingress","purpose":"Validate records against versioned structural and semantic contracts.","inputs":[{"name":"records","type":"raw_record","cardinality":"many"}],"outputs":[{"name":"valid","type":"contracted_record","cardinality":"many"},{"name":"violations","type":"finding","cardinality":"many"}],"requires":[],"config":["contract_ref","compatibility_mode","on_violation"],"invariants":["every accepted record names a contract version"],"failure_modes":["schema drift","semantic constraint failure"],"auxiliary_needs":["schema registry","quarantine store"]},
    {"id":"machine.unit_normalize","layer":"ingress","purpose":"Convert quantities to canonical units without changing meaning.","inputs":[{"name":"records","type":"contracted_record","cardinality":"many"}],"outputs":[{"name":"observations","type":"observation","cardinality":"many"}],"requires":["machine.contract_validate"],"config":["unit_system_ref","rounding_policy"],"invariants":["conversion is reversible within declared tolerance"],"failure_modes":["unknown unit","precision loss"],"auxiliary_needs":["unit registry","calibration metadata"]},
    {"id":"machine.identity_resolve","layer":"ingress","purpose":"Map source identifiers to stable canonical entities by explicit rules.","inputs":[{"name":"records","type":"contracted_record","cardinality":"many"}],"outputs":[{"name":"entities","type":"entity","cardinality":"many"}],"requires":["machine.contract_validate"],"config":["identity_rules_ref","conflict_policy"],"invariants":["every merge is explainable and reversible"],"failure_modes":["collision","orphan identifier"],"auxiliary_needs":["identity map","manual resolution queue"]},
    {"id":"machine.event_order","layer":"temporal","purpose":"Establish event-time order with lateness and correction semantics.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"ordered","type":"event","cardinality":"many"}],"requires":[],"config":["event_time_field","watermark","deduplication_key"],"invariants":["ordering policy is deterministic"],"failure_modes":["late event","duplicate event","clock skew"],"auxiliary_needs":["state store","clock policy"]},
    {"id":"machine.window","layer":"temporal","purpose":"Create fixed, sliding, session, or domain-calendar intervals.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"intervals","type":"interval","cardinality":"many"}],"requires":["machine.event_order"],"config":["window_policy_ref","calendar_ref"],"invariants":["boundary inclusivity is explicit"],"failure_modes":["timezone ambiguity","overlap error"],"auxiliary_needs":["calendar registry"]},
    {"id":"machine.state_reconstruct","layer":"temporal","purpose":"Rebuild entity state from ordered events and transition rules.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"state","type":"observation","cardinality":"many"}],"requires":["machine.event_order"],"config":["state_model_ref","correction_policy"],"invariants":["same event log and rules produce same state"],"failure_modes":["illegal transition","missing predecessor"],"auxiliary_needs":["checkpoint store","transition-rule registry"]},
    {"id":"machine.join","layer":"transform","purpose":"Combine typed datasets under declared key, temporal, or interval semantics.","inputs":[{"name":"left","type":"observation","cardinality":"many"},{"name":"right","type":"observation","cardinality":"many"}],"outputs":[{"name":"joined","type":"observation","cardinality":"many"}],"requires":[],"config":["join_keys","join_kind","temporal_semantics"],"invariants":["cardinality expectation is tested"],"failure_modes":["fanout","key loss","temporal leakage"],"auxiliary_needs":["statistics","spill storage"]},
    {"id":"machine.aggregate","layer":"transform","purpose":"Reduce observations by dimensions, measure algebra, and interval.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"values","type":"metric_value","cardinality":"many"}],"requires":[],"config":["dimensions","measure_ref","grain","null_policy"],"invariants":["measure additivity is declared"],"failure_modes":["mixed grain","double counting"],"auxiliary_needs":["measure registry"]},
    {"id":"machine.segment","layer":"transform","purpose":"Assign entities or intervals to rule-defined cohorts.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"segments","type":"relation","cardinality":"many"}],"requires":[],"config":["segment_rules_ref","overlap_policy"],"invariants":["membership has an effective interval"],"failure_modes":["ambiguous membership"],"auxiliary_needs":["rule registry"]},
    {"id":"machine.metric_compute","layer":"semantic","purpose":"Evaluate versioned metric expressions at a declared grain.","inputs":[{"name":"values","type":"metric_value","cardinality":"many"}],"outputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"requires":["machine.aggregate"],"config":["metric_definitions_ref","as_of_policy"],"invariants":["metric version and grain accompany every value"],"failure_modes":["undefined denominator","grain mismatch"],"auxiliary_needs":["metric registry","semantic cache"]},
    {"id":"machine.variance","layer":"diagnostic","purpose":"Decompose difference between actual, baseline, plan, or peer values.","inputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"}],"requires":["machine.metric_compute"],"config":["baseline_ref","decomposition_ref","tolerance_ref"],"invariants":["components reconcile to total variance"],"failure_modes":["non-comparable baseline"],"auxiliary_needs":["baseline store"]},
    {"id":"machine.change_detect","layer":"diagnostic","purpose":"Detect deterministic threshold, control-chart, or statistical regime changes.","inputs":[{"name":"series","type":"time_series","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"}],"requires":[],"config":["detector_ref","significance","minimum_duration"],"invariants":["false-positive policy is stated"],"failure_modes":["seasonality confound","insufficient history"],"auxiliary_needs":["baseline store"]},
    {"id":"machine.root_cause","layer":"diagnostic","purpose":"Rank explainable candidate causes using dependency graphs and contribution rules.","inputs":[{"name":"findings","type":"finding","cardinality":"many"},{"name":"relations","type":"relation","cardinality":"many"}],"outputs":[{"name":"causes","type":"finding","cardinality":"many"}],"requires":["machine.variance"],"config":["causal_graph_ref","contribution_policy"],"invariants":["output distinguishes association from causal identification"],"failure_modes":["missing dependency","confounding"],"auxiliary_needs":["dependency graph","evidence ledger"]},
    {"id":"machine.process_conformance","layer":"diagnostic","purpose":"Compare observed event sequences with allowed process models.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"}],"requires":["machine.event_order"],"config":["process_model_ref","case_key_ref","cost_model_ref"],"invariants":["alignment costs are explicit"],"failure_modes":["case ambiguity","incomplete traces"],"auxiliary_needs":["process model registry"]},
    {"id":"machine.forecast","layer":"predictive_non_ai","purpose":"Produce statistical time-series forecasts and intervals.","inputs":[{"name":"series","type":"time_series","cardinality":"many"}],"outputs":[{"name":"forecast","type":"time_series","cardinality":"many"}],"requires":[],"config":["method_ref","horizon","seasonality","interval_level"],"invariants":["backtest window precedes forecast window"],"failure_modes":["structural break","insufficient cycles"],"auxiliary_needs":["backtest harness","model-state store"]},
    {"id":"machine.experiment_measure","layer":"causal","purpose":"Estimate treatment effects from randomized or explicitly identified designs.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"effects","type":"finding","cardinality":"many"}],"requires":[],"config":["estimand_ref","design_ref","assignment_ref","stopping_rule_ref"],"invariants":["estimand and identification assumptions are recorded"],"failure_modes":["interference","attrition","peeking"],"auxiliary_needs":["assignment ledger","power calculator"]},
    {"id":"machine.simulate","layer":"decision","purpose":"Evaluate scenarios with deterministic, discrete-event, or Monte Carlo models.","inputs":[{"name":"state","type":"observation","cardinality":"many"}],"outputs":[{"name":"scenarios","type":"metric_value","cardinality":"many"}],"requires":[],"config":["simulation_model_ref","parameter_set_ref","seed_policy"],"invariants":["scenario inputs and random seeds are reproducible"],"failure_modes":["invalid assumptions","unstable variance"],"auxiliary_needs":["scenario store","randomness service"]},
    {"id":"machine.optimize","layer":"decision","purpose":"Select decisions under objective, constraint, and cost definitions.","inputs":[{"name":"scenarios","type":"metric_value","cardinality":"many"}],"outputs":[{"name":"decisions","type":"decision","cardinality":"many"}],"requires":["machine.simulate"],"config":["objective_ref","constraints_ref","cost_model_ref","solver_profile"],"invariants":["feasibility and optimality status accompany output"],"failure_modes":["infeasible model","unbounded objective","timeout"],"auxiliary_needs":["solver adapter","solution audit"]},
    {"id":"machine.spatial_join","layer":"spatial","purpose":"Relate entities and observations by declared spatial predicates.","inputs":[{"name":"features","type":"spatial_feature","cardinality":"many"},{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"relations","type":"relation","cardinality":"many"}],"requires":[],"config":["crs","predicate","precision"],"invariants":["coordinate reference system is explicit"],"failure_modes":["invalid geometry","projection distortion"],"auxiliary_needs":["geometry engine","CRS registry"]},
    {"id":"machine.network_measure","layer":"network","purpose":"Compute paths, flow, connectivity, centrality, and components on typed graphs.","inputs":[{"name":"relations","type":"relation","cardinality":"many"}],"outputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"requires":[],"config":["graph_semantics_ref","measure_ref","directionality"],"invariants":["node and edge meanings are declared"],"failure_modes":["disconnected graph","weight ambiguity"],"auxiliary_needs":["graph store"]},
    {"id":"machine.alert_evaluate","layer":"delivery","purpose":"Evaluate stateful alert rules with suppression and escalation.","inputs":[{"name":"findings","type":"finding","cardinality":"many"}],"outputs":[{"name":"actions","type":"action","cardinality":"many"}],"requires":[],"config":["alert_rules_ref","routing_ref","suppression_ref"],"invariants":["every action points to evidence and rule version"],"failure_modes":["alert storm","missed escalation"],"auxiliary_needs":["notification adapter","incident state"]},
    {"id":"machine.publish","layer":"delivery","purpose":"Render or expose governed metrics, findings, decisions, and actions.","inputs":[{"name":"artifacts","type":"finding","cardinality":"many"}],"outputs":[{"name":"actions","type":"action","cardinality":"many"}],"requires":[],"config":["presentation_ref","audience_ref","channel_ref"],"invariants":["authorization is checked at query and delivery"],"failure_modes":["stale output","unauthorized disclosure"],"auxiliary_needs":["semantic API","renderer","delivery adapters"]},
    {"id":"machine.policy_enforce","layer":"control","purpose":"Apply access, purpose, retention, residency, and privacy rules.","inputs":[{"name":"records","type":"contracted_record","cardinality":"many"}],"outputs":[{"name":"valid","type":"contracted_record","cardinality":"many"}],"requires":[],"config":["policy_bundle_ref","principal_context_ref"],"invariants":["deny is default when no rule matches"],"failure_modes":["policy conflict","missing context"],"auxiliary_needs":["identity provider","policy decision log"]},
    {"id":"machine.quality_test","layer":"control","purpose":"Evaluate data and metric assertions at boundaries.","inputs":[{"name":"records","type":"contracted_record","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"}],"requires":[],"config":["test_suite_ref","severity_policy"],"invariants":["test result names input version and boundary"],"failure_modes":["flaky test","silent sampling bias"],"auxiliary_needs":["test registry","result store"]},
    {"id":"machine.lineage_record","layer":"control","purpose":"Record dataset, metric, rule, and execution provenance.","inputs":[{"name":"records","type":"contracted_record","cardinality":"many"}],"outputs":[{"name":"relations","type":"relation","cardinality":"many"}],"requires":[],"config":["namespace","retention"],"invariants":["every material output has upstream edges"],"failure_modes":["missing instrumentation"],"auxiliary_needs":["lineage store"]},
    {"id":"machine.cost_meter","layer":"control","purpose":"Attribute compute, storage, transfer, license, and operational costs.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"requires":[],"config":["cost_model_ref","allocation_keys","currency_ref"],"invariants":["allocated costs reconcile to source total"],"failure_modes":["unallocated shared cost","currency mismatch"],"auxiliary_needs":["price book","usage ledger"]},
    {"id":"machine.source_capture","layer":"connector","purpose":"Read snapshots, changes, events, files, or API pages into a replayable raw envelope.","inputs":[{"name":"request","type":"action","cardinality":"one"}],"outputs":[{"name":"records","type":"raw_record","cardinality":"many"},{"name":"events","type":"event","cardinality":"many"}],"requires":[],"config":["source_adapter_ref","cursor_policy","snapshot_or_change","rate_limit_policy"],"invariants":["source position and envelope identity accompany every output"],"failure_modes":["cursor loss","partial page","source mutation","rate limiting"],"auxiliary_needs":["credential reference","cursor store","dead-letter store"]},
    {"id":"machine.destination_deliver","layer":"connector","purpose":"Apply governed records or actions to a destination with declared delivery semantics.","inputs":[{"name":"actions","type":"action","cardinality":"many"}],"outputs":[{"name":"receipts","type":"event","cardinality":"many"}],"requires":[],"config":["destination_adapter_ref","delivery_semantics","idempotency_key_ref","rate_limit_policy"],"invariants":["each attempt has an idempotency key and durable receipt"],"failure_modes":["partial write","duplicate delivery","destination drift"],"auxiliary_needs":["credential reference","outbox","retry scheduler"]},
    {"id":"machine.delivery_reconcile","layer":"connector","purpose":"Compare intended and observed destination state and issue deterministic repairs.","inputs":[{"name":"intended","type":"action","cardinality":"many"},{"name":"receipts","type":"event","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"},{"name":"repairs","type":"action","cardinality":"many"}],"requires":["machine.destination_deliver"],"config":["reconciliation_key_ref","comparison_policy","repair_policy"],"invariants":["repair never loses the original intent or receipt"],"failure_modes":["eventual-consistency race","irreversible destination mutation"],"auxiliary_needs":["intent ledger","receipt store","manual exception queue"]},
    {"id":"machine.relational_execute","layer":"execution","purpose":"Bind and execute a typed portable relational plan against an engine.","inputs":[{"name":"plan","type":"plan","cardinality":"one"}],"outputs":[{"name":"observations","type":"observation","cardinality":"many"}],"requires":[],"config":["engine_adapter_ref","resource_profile","spill_policy"],"invariants":["logical plan and engine/version are recorded"],"failure_modes":["unsupported operation","resource exhaustion","nondeterministic function"],"auxiliary_needs":["execution engine","columnar interchange","spill store"]},
    {"id":"machine.stream_execute","layer":"execution","purpose":"Execute stateful event transforms with checkpoint, watermark, replay, and recovery semantics.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"events","type":"event","cardinality":"many"}],"requires":["machine.event_order"],"config":["plan_ref","checkpoint_policy","state_backend_ref","delivery_semantics"],"invariants":["recovery semantics and state version are explicit"],"failure_modes":["checkpoint corruption","unbounded state","backpressure"],"auxiliary_needs":["checkpoint store","state backend","scheduler"]},
    {"id":"machine.build_execute","layer":"execution","purpose":"Compile a dependency graph, select incremental work, execute it, and promote versioned artifacts.","inputs":[{"name":"plan","type":"plan","cardinality":"one"}],"outputs":[{"name":"artifacts","type":"artifact","cardinality":"many"}],"requires":["machine.lineage_record"],"config":["build_graph_ref","incremental_policy","environment_ref","promotion_policy"],"invariants":["artifact identity includes code, configuration, inputs, and environment"],"failure_modes":["stale dependency","partial promotion","non-reproducible build"],"auxiliary_needs":["artifact store","scheduler","environment registry"]},
    {"id":"machine.regression_fit","layer":"econometric","purpose":"Estimate declared statistical regression models with diagnostics and uncertainty.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"model","type":"model","cardinality":"one"},{"name":"diagnostics","type":"finding","cardinality":"many"}],"requires":[],"config":["formula_ref","estimator_ref","error_structure_ref","diagnostic_suite_ref"],"invariants":["formula, estimator, assumptions, sample and diagnostics are retained"],"failure_modes":["collinearity","misspecification","heteroskedasticity","leakage"],"auxiliary_needs":["linear algebra backend","model registry"]},
    {"id":"machine.quasi_estimate","layer":"econometric","purpose":"Estimate effects using difference-in-differences, discontinuity, matching, instruments, or synthetic controls.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"effects","type":"finding","cardinality":"many"}],"requires":["machine.regression_fit"],"config":["design_ref","estimand_ref","identification_assumptions_ref","sensitivity_suite_ref"],"invariants":["identification assumptions and falsification tests accompany estimates"],"failure_modes":["parallel-trends failure","weak instrument","poor overlap","spillover"],"auxiliary_needs":["design registry","diagnostic plot renderer"]},
    {"id":"machine.response_curve","layer":"econometric","purpose":"Estimate elasticity, lag, saturation, mix, and counterfactual response curves.","inputs":[{"name":"model","type":"model","cardinality":"one"}],"outputs":[{"name":"scenarios","type":"metric_value","cardinality":"many"}],"requires":["machine.regression_fit"],"config":["transform_ref","baseline_ref","counterfactual_grid_ref"],"invariants":["extrapolation range is marked and constrained"],"failure_modes":["non-identification","extrapolation","unstable elasticity"],"auxiliary_needs":["scenario store","curve diagnostics"]},
    {"id":"machine.survival_fit","layer":"reliability_risk","purpose":"Estimate time-to-event distributions with censoring, truncation, and competing-risk semantics.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"distribution","type":"distribution","cardinality":"many"}],"requires":[],"config":["time_origin_ref","event_definition_ref","censoring_policy","estimator_ref"],"invariants":["risk set and censoring assumptions are explicit"],"failure_modes":["informative censoring","immortal-time bias","sparse tail"],"auxiliary_needs":["statistical backend","diagnostic suite"]},
    {"id":"machine.frequency_severity","layer":"reliability_risk","purpose":"Estimate occurrence frequency and conditional magnitude distributions.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"distribution","type":"distribution","cardinality":"many"}],"requires":[],"config":["exposure_ref","frequency_family_ref","severity_family_ref","tail_policy"],"invariants":["exposure and zero-generation mechanisms are explicit"],"failure_modes":["overdispersion","heavy-tail instability","selection bias"],"auxiliary_needs":["statistical backend","distribution registry"]},
    {"id":"machine.reserve_estimate","layer":"reliability_risk","purpose":"Estimate outstanding obligations or future requirements from development patterns and assumptions.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"distribution","type":"distribution","cardinality":"many"}],"requires":["machine.frequency_severity"],"config":["development_pattern_ref","method_ref","tail_factor_ref"],"invariants":["observed, estimated and assumption-driven components are separated"],"failure_modes":["calendar shift","tail sensitivity","structural change"],"auxiliary_needs":["assumption registry","backtest harness"]},
    {"id":"machine.stress_test","layer":"reliability_risk","purpose":"Apply coherent scenarios to exposures, dependencies, and distributions and aggregate impacts.","inputs":[{"name":"distribution","type":"distribution","cardinality":"many"}],"outputs":[{"name":"findings","type":"finding","cardinality":"many"}],"requires":["machine.simulate"],"config":["scenario_set_ref","dependency_model_ref","aggregation_policy"],"invariants":["base and stressed assumptions remain comparable"],"failure_modes":["incoherent scenario","double-counted dependency"],"auxiliary_needs":["scenario registry","exposure store"]},
    {"id":"machine.contribution_bound","layer":"privacy_compute","purpose":"Clip, sample, or limit each privacy unit's contribution before release.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"observations","type":"observation","cardinality":"many"}],"requires":[],"config":["privacy_unit_ref","bounds_ref","sampling_policy"],"invariants":["declared sensitivity bound is enforceable from output"],"failure_modes":["unbounded contribution","privacy-unit ambiguity"],"auxiliary_needs":["privacy-unit registry","bounds audit"]},
    {"id":"machine.private_release","layer":"privacy_compute","purpose":"Produce a differentially private statistic while accounting for cumulative privacy loss.","inputs":[{"name":"observations","type":"observation","cardinality":"many"}],"outputs":[{"name":"metrics","type":"metric_value","cardinality":"many"},{"name":"receipt","type":"finding","cardinality":"one"}],"requires":["machine.contribution_bound"],"config":["mechanism_ref","epsilon","delta","accountant_ref","budget_scope_ref"],"invariants":["release is refused when budget or sensitivity is undefined"],"failure_modes":["budget exhaustion","invalid composition","incorrect sensitivity"],"auxiliary_needs":["privacy ledger","cryptographic randomness","release audit"]},
    {"id":"machine.cleanroom_execute","layer":"privacy_compute","purpose":"Execute approved multi-party plans under input, query, and output policies.","inputs":[{"name":"plan","type":"plan","cardinality":"one"}],"outputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"requires":["machine.policy_enforce","machine.lineage_record"],"config":["participant_contract_ref","query_policy_ref","output_policy_ref","execution_boundary_ref"],"invariants":["raw participant inputs never cross the declared boundary"],"failure_modes":["join leakage","small-group disclosure","policy bypass"],"auxiliary_needs":["isolated execution boundary","key management","output checker","audit log"]},
    {"id":"machine.interaction_capture","layer":"interaction","purpose":"Capture user-interface interactions as consented, redacted, versioned events.","inputs":[{"name":"records","type":"raw_record","cardinality":"many"}],"outputs":[{"name":"events","type":"event","cardinality":"many"}],"requires":[],"config":["capture_schema_ref","consent_policy_ref","redaction_policy_ref","sampling_policy"],"invariants":["sensitive fields are removed before persistence"],"failure_modes":["sensitive capture","version drift","observer effect"],"auxiliary_needs":["client SDK","redaction engine","consent state"]},
    {"id":"machine.interaction_replay","layer":"interaction","purpose":"Reconstruct a deterministic visual or task trace from captured interactions and state snapshots.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"artifact","type":"artifact","cardinality":"one"}],"requires":["machine.interaction_capture","machine.event_order"],"config":["state_snapshot_ref","renderer_ref","masking_policy_ref"],"invariants":["replay cannot reveal fields removed at capture"],"failure_modes":["missing state","renderer drift","privacy leak"],"auxiliary_needs":["state snapshot store","sandboxed renderer"]},
    {"id":"machine.visual_encode","layer":"interaction","purpose":"Compile metric and finding semantics into an accessible declarative visual representation.","inputs":[{"name":"metrics","type":"metric_value","cardinality":"many"}],"outputs":[{"name":"artifact","type":"artifact","cardinality":"one"}],"requires":[],"config":["visual_spec_ref","interaction_spec_ref","accessibility_policy_ref"],"invariants":["encoding preserves units, grain, uncertainty and provenance"],"failure_modes":["misleading scale","overplotting","inaccessible interaction"],"auxiliary_needs":["visual grammar compiler","accessibility checker"]},
    {"id":"machine.human_review","layer":"interaction","purpose":"Route evidence to an authorized reviewer and record an accountable decision.","inputs":[{"name":"findings","type":"finding","cardinality":"many"}],"outputs":[{"name":"decisions","type":"decision","cardinality":"many"}],"requires":[],"config":["review_policy_ref","assignment_policy_ref","escalation_ref","reason_code_ref"],"invariants":["decision records reviewer, evidence, policy, reason and time"],"failure_modes":["conflict of interest","unreviewed timeout","rubber stamping"],"auxiliary_needs":["work queue","identity provider","decision ledger"]},
    {"id":"machine.trace_project","layer":"process_projection","purpose":"Project event streams into case traces using explicit correlation and lifecycle rules.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"traces","type":"relation","cardinality":"many"}],"requires":["machine.event_order"],"config":["case_key_ref","activity_ref","lifecycle_ref"],"invariants":["each event's inclusion and ordering are explainable"],"failure_modes":["case ambiguity","event loss","lifecycle mismatch"],"auxiliary_needs":["event-log store","projection registry"]},
    {"id":"machine.object_event_project","layer":"process_projection","purpose":"Project events, objects, and their changing relations without forcing a single case identifier.","inputs":[{"name":"events","type":"event","cardinality":"many"}],"outputs":[{"name":"relations","type":"relation","cardinality":"many"}],"requires":["machine.event_order"],"config":["object_types_ref","event_object_rules_ref","qualifier_ref"],"invariants":["object and relationship identifiers remain stable across projections"],"failure_modes":["object duplication","ambiguous qualifier","temporal inconsistency"],"auxiliary_needs":["object-centric event store"]},
