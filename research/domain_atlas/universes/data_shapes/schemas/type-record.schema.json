{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/data-type-record-v1.json",
  "title": "Provider-neutral carrier or semantic value type candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["type_id", "record_kind", "name", "definition", "status", "owner_context", "parameters", "parent_type_ids", "allowed_carriers", "equality_laws", "order_laws", "arithmetic_laws", "invalid_inferences", "missingness", "uncertainty", "time_semantics", "provenance", "canonicalization", "compatibility", "evidence_refs", "compiler_obligations"],
  "properties": {
    "type_id": {"type": "string", "pattern": "^dt\\.(carrier|semantic|qualifier)\\.[a-z0-9_.-]+$"},
    "record_kind": {"enum": ["carrier_type", "semantic_value_type", "qualifier_type"]},
    "name": {"type": "string", "minLength": 2},
    "definition": {"type": "string", "minLength": 15},
    "status": {"enum": ["candidate", "provisional", "verified"]},
    "owner_context": {"type": "string", "pattern": "^bc\\.[a-z0-9_.-]+$"},
    "parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "parent_type_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "allowed_carriers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "equality_laws": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "order_laws": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "arithmetic_laws": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "invalid_inferences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "missingness": {"type": "object", "additionalProperties": false, "required": ["model", "allowed_reasons", "null_is_reason"], "properties": {"model": {"type": "string"}, "allowed_reasons": {"type": "array", "items": {"type": "string"}}, "null_is_reason": {"const": false}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["model", "propagation_required"], "properties": {"model": {"type": "string"}, "propagation_required": {"type": "boolean"}}},
    "time_semantics": {"type": "object", "additionalProperties": false, "required": ["role", "timezone_or_calendar_required"], "properties": {"role": {"type": "string"}, "timezone_or_calendar_required": {"type": "boolean"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["minimum", "authority_required"], "properties": {"minimum": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_required": {"type": "boolean"}}},
    "canonicalization": {"type": "object", "additionalProperties": false, "required": ["rule", "digest_safe_without_profile"], "properties": {"rule": {"type": "string"}, "digest_safe_without_profile": {"type": "boolean"}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["relation", "loss_conditions"], "properties": {"relation": {"type": "string"}, "loss_conditions": {"type": "array", "items": {"type": "string"}}}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DSS-[0-9]{3}$"}},
    "compiler_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "extension_point": {"type": "boolean"}
  }
}
