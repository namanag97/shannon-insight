{
  "$id": "https://san.local/domain-atlas/security-privacy-trust/capability-offers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "assurance": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "cross_platform_map": {
      "additionalProperties": false,
      "properties": {
        "consumption": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "governance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "persistence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pipelines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "runtime": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_occurrences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "types_shapes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "source_occurrences",
        "types_shapes",
        "pipelines",
        "persistence",
        "runtime",
        "governance",
        "lineage",
        "consumption"
      ],
      "type": "object"
    },
    "declared_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "limits": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "offer_id": {
      "minLength": 3,
      "type": "string"
    },
    "offer_kind": {
      "minLength": 1,
      "type": "string"
    },
    "provider_binding": {
      "type": [
        "string",
        "null"
      ]
    },
    "qualification_state": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "sourced_candidate",
        "open_candidate_gap"
      ],
      "type": "string"
    }
  },
  "required": [
    "assurance",
    "cross_platform_map",
    "declared_capabilities",
    "edition",
    "evidence_source_ids",
    "limits",
    "offer_id",
    "offer_kind",
    "provider_binding",
    "qualification_state",
    "status"
  ],
  "title": "Security Privacy Trust capability-offers candidate",
  "type": "object"
}
