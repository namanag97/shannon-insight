{
  "metadata": {
    "version": "2.0.0",
    "as_of": "2026-08-12",
    "scope": "Extensible canonical data ontology for composable non-AI analytics",
    "non_exhaustiveness_rule": "No finite catalogue can enumerate every domain-specific type. This ontology defines the closed core type constructors and an explicit extension protocol; domain packs extend semantic types without inventing new carrier semantics.",
    "critical_distinction": "Analytics types are products or capabilities. Data types are carriers, semantic values, observations, or analytical structures. They are modeled at separate levels."
  },
  "standards_sources": [
    {"id":"std_json_schema","name":"JSON Schema Draft 2020-12","url":"https://json-schema.org/draft/2020-12/schema","supports":["carrier and composite validation"]},
    {"id":"std_arrow","name":"Apache Arrow Columnar Format","url":"https://arrow.apache.org/docs/format/Columnar.html","supports":["language-neutral carrier types","physical layouts","extension types"]},
    {"id":"std_ucum","name":"Unified Code for Units of Measure 2.2","url":"https://ucum.org/ucum","supports":["machine-readable units","quantity conversion"]},
    {"id":"std_cloudevents","name":"CloudEvents specification","url":"https://cloudevents.io/","supports":["portable event envelopes"]},
    {"id":"std_w3c_prov","name":"W3C PROV Data Model","url":"https://www.w3.org/TR/prov-dm/","supports":["entities","activities","agents","derivation and responsibility"]},
    {"id":"std_substrait","name":"Substrait specification","url":"https://substrait.io/spec/specification/","supports":["typed portable relational plans"]},
    {"id":"std_ocel2","name":"OCEL 2.0 specification","url":"https://www.ocel-standard.org/specification/","supports":["object-centric event structures"]},
    {"id":"std_opentelemetry","name":"OpenTelemetry semantic conventions","url":"https://opentelemetry.io/docs/specs/semconv/","supports":["operational events","metrics","resources","traces"]}
  ],
  "type_stack": [
    {"level":0,"id":"physical_layout","question":"How are bits and buffers encoded?","examples":["fixed-width buffer","variable-width buffer","dictionary encoding","columnar array"],"domain_customizable":false},
    {"level":1,"id":"carrier_type","question":"What values can the runtime store and validate?","examples":["boolean","integer","decimal","timestamp","UTF-8"],"domain_customizable":false},
    {"level":2,"id":"composite_type","question":"How are carrier values structurally combined?","examples":["optional","list","map","struct","union","reference"],"domain_customizable":false},
    {"level":3,"id":"semantic_value_type","question":"What does a stored value mean and which operations are valid?","examples":["identifier","currency amount","probability","rate","physical quantity"],"domain_customizable":true},
    {"level":4,"id":"observation_type","question":"What fact about the world is asserted, at what grain and time?","examples":["entity","event","measurement","relationship","transaction"],"domain_customizable":true},
    {"level":5,"id":"analytical_structure","question":"What mathematical structure does an analytical method consume?","examples":["event log","time series","panel","graph","raster","experiment ledger"],"domain_customizable":false},
    {"level":6,"id":"analytical_machine","question":"What reusable transformation is applied?","examples":["aggregate","forecast","conformance check","optimize"],"domain_customizable":false},
    {"level":7,"id":"analytics_type","question":"What coherent analytical capability is exposed?","examples":["process discovery","marketing-mix modeling","credit-risk analytics"],"domain_customizable":false},
    {"level":8,"id":"domain_pack","question":"Which industry vocabulary, rules, units, costs and bindings specialize the platform?","examples":["sports","oil and gas"],"domain_customizable":true},
    {"level":9,"id":"composition","question":"Which machines, domain bindings, infrastructure and service levels form a deployed product?","examples":["sports performance operations","oil production operations"],"domain_customizable":true}
  ],
  "carrier_types": [
    {"id":"carrier.null","parameters":[],"meaning":"Explicit absence carrier; never sufficient to explain why a value is absent.","source_ids":["std_json_schema","std_arrow"]},
    {"id":"carrier.boolean","parameters":[],"meaning":"Two-valued logical carrier.","source_ids":["std_json_schema","std_arrow"]},
    {"id":"carrier.signed_integer","parameters":["bit_width"],"meaning":"Signed whole-number carrier.","source_ids":["std_arrow"]},
    {"id":"carrier.unsigned_integer","parameters":["bit_width"],"meaning":"Non-negative whole-number carrier.","source_ids":["std_arrow"]},
    {"id":"carrier.floating_point","parameters":["precision"],"meaning":"Approximate binary real-number carrier; equality and accumulation require numerical policy.","source_ids":["std_arrow"]},
    {"id":"carrier.decimal","parameters":["precision","scale","bit_width"],"meaning":"Base-10 fixed-precision carrier appropriate where decimal exactness matters.","source_ids":["std_arrow"]},
    {"id":"carrier.utf8","parameters":["normalization","locale"],"meaning":"Unicode text carrier; collation and normalization are separate semantics.","source_ids":["std_json_schema","std_arrow"]},
    {"id":"carrier.binary","parameters":["byte_width"],"meaning":"Opaque byte sequence carrier.","source_ids":["std_arrow"]},
    {"id":"carrier.date","parameters":["calendar"],"meaning":"Calendar date without time-of-day.","source_ids":["std_arrow"]},
    {"id":"carrier.time","parameters":["unit"],"meaning":"Time-of-day without date or timezone.","source_ids":["std_arrow"]},
    {"id":"carrier.timestamp","parameters":["unit","timezone"],"meaning":"Point on, or local representation of, a time scale; timezone semantics are mandatory.","source_ids":["std_arrow"]},
    {"id":"carrier.duration","parameters":["unit"],"meaning":"Elapsed amount of time, distinct from a calendar interval.","source_ids":["std_arrow"]},
    {"id":"carrier.calendar_interval","parameters":["unit","calendar"],"meaning":"Calendar-relative interval whose length may vary by anchor.","source_ids":["std_arrow"]},
    {"id":"carrier.fixed_binary","parameters":["byte_width"],"meaning":"Fixed-length opaque value used for hashes, packed identifiers or protocol values.","source_ids":["std_arrow"]},
    {"id":"carrier.extension","parameters":["storage_type","extension_name","extension_metadata"],"meaning":"Application semantic type layered on a standard storage carrier.","source_ids":["std_arrow"]}
  ],
  "composite_types": [
    {"id":"composite.optional","constructor":"optional<T>","meaning":"Value may be absent; missingness reason remains separate."},
    {"id":"composite.list","constructor":"list<T>","meaning":"Ordered, variable-length collection with possible duplicates."},
    {"id":"composite.fixed_list","constructor":"fixed_list<T,n>","meaning":"Ordered collection with statically fixed length."},
    {"id":"composite.set","constructor":"set<T>","meaning":"Unordered unique collection; implemented over a list or relation when necessary."},
    {"id":"composite.map","constructor":"map<K,V>","meaning":"Key-value association with declared key uniqueness."},
    {"id":"composite.struct","constructor":"struct<fields...>","meaning":"Named product of typed fields."},
    {"id":"composite.union","constructor":"union<variants...>","meaning":"Exactly one of several declared variants."},
    {"id":"composite.dictionary","constructor":"dictionary<K,V>","meaning":"Encoded categorical carrier with explicit dictionary identity and version."},
    {"id":"composite.key","constructor":"key<T,namespace>","meaning":"Value constrained to uniqueness within a namespace."},
    {"id":"composite.reference","constructor":"reference<T,target>","meaning":"Typed link to another entity, observation or artifact."},
    {"id":"composite.interval","constructor":"interval<T,boundary_policy>","meaning":"Pair of ordered bounds with explicit open/closed and unbounded semantics."},
    {"id":"composite.tensor","constructor":"tensor<T,axes...>","meaning":"Dense or sparse multidimensional array with named axes and coordinates."}
  ],
  "semantic_value_types": [
    {"id":"semantic.identifier","allowed_carriers":["carrier.utf8","carrier.signed_integer","carrier.unsigned_integer","carrier.fixed_binary"],"required_qualifiers":["namespace","stability","uniqueness_scope"],"valid_operations":["equality","join","group"],"invalid_inferences":["numeric order implies semantic order"]},
    {"id":"semantic.label","allowed_carriers":["carrier.utf8"],"required_qualifiers":["language","normalization"],"valid_operations":["display","search"],"invalid_inferences":["label is stable identity"]},
    {"id":"semantic.nominal_category","allowed_carriers":["carrier.utf8","carrier.signed_integer","carrier.unsigned_integer"],"required_qualifiers":["code_system","code_system_version"],"valid_operations":["equality","membership","frequency"],"invalid_inferences":["ordering","distance","arithmetic mean"]},
    {"id":"semantic.ordinal_category","allowed_carriers":["carrier.utf8","carrier.signed_integer","carrier.unsigned_integer"],"required_qualifiers":["ordered_code_set","version"],"valid_operations":["equality","ordering","median","quantile"],"invalid_inferences":["equal spacing","ratio"]},
    {"id":"semantic.count","allowed_carriers":["carrier.signed_integer","carrier.unsigned_integer","carrier.decimal"],"required_qualifiers":["counted_object","aggregation_scope"],"valid_operations":["sum","difference","rate"],"invalid_inferences":["fractional value unless weighted or estimated"]},
    {"id":"semantic.quantity","allowed_carriers":["carrier.signed_integer","carrier.unsigned_integer","carrier.floating_point","carrier.decimal"],"required_qualifiers":["quantity_kind","unit_code","unit_system","precision","measurement_method"],"valid_operations":["unit_conversion","comparison","dimensionally_valid_arithmetic"],"invalid_inferences":["arithmetic across incompatible dimensions"],"preferred_standard":"std_ucum"},
    {"id":"semantic.interval_measure","allowed_carriers":["carrier.signed_integer","carrier.floating_point","carrier.decimal","carrier.timestamp"],"required_qualifiers":["scale_definition","reference_origin"],"valid_operations":["difference","mean"],"invalid_inferences":["ratio without meaningful zero"]},
    {"id":"semantic.ratio_measure","allowed_carriers":["carrier.signed_integer","carrier.unsigned_integer","carrier.floating_point","carrier.decimal","carrier.duration"],"required_qualifiers":["scale_definition","absolute_zero"],"valid_operations":["difference","ratio","mean"],"invalid_inferences":[]},
    {"id":"semantic.rate","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["numerator_definition","denominator_definition","window","unit"],"valid_operations":["weighted_aggregation","comparison"],"invalid_inferences":["unweighted averaging across unequal denominators"]},
    {"id":"semantic.proportion","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["numerator_population","denominator_population","bounds"],"valid_operations":["weighted_aggregation","comparison"],"invalid_inferences":["sum across overlapping populations"]},
    {"id":"semantic.probability","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["target_event","population","prediction_horizon","conditioning_information","calibration_version","bounds"],"valid_operations":["calibration","proper_scoring","expected_value"],"invalid_inferences":["treat arbitrary score as probability"]},
    {"id":"semantic.score","allowed_carriers":["carrier.signed_integer","carrier.floating_point","carrier.decimal"],"required_qualifiers":["construction","range","direction","version"],"valid_operations":["ranking","thresholding_if_validated"],"invalid_inferences":["probability","equal-interval meaning unless established"]},
    {"id":"semantic.index","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["base_period","basket_or_components","weighting","version"],"valid_operations":["relative_change","comparison_under_same_definition"],"invalid_inferences":["comparison across incompatible bases"]},
    {"id":"semantic.currency_amount","allowed_carriers":["carrier.decimal"],"required_qualifiers":["currency_code","valuation_date","price_basis","rounding_policy"],"valid_operations":["same_currency_arithmetic","fx_conversion_with_rate_provenance"],"invalid_inferences":["addition across currencies without conversion"]},
    {"id":"semantic.cost","allowed_carriers":["carrier.decimal"],"required_qualifiers":["currency_code","cost_scope","allocation_basis","valuation_date"],"valid_operations":["allocation","sum_within_scope","unit_cost"],"invalid_inferences":["mix sunk, marginal, fixed and variable cost"]},
    {"id":"semantic.timestamp","allowed_carriers":["carrier.timestamp"],"required_qualifiers":["temporal_role","timezone_policy","precision"],"valid_operations":["ordering_within_same_time_scale","duration"],"invalid_inferences":["event time equals ingestion time"]},
    {"id":"semantic.time_interval","allowed_carriers":["carrier.timestamp","carrier.date"],"required_qualifiers":["start_role","end_role","boundary_policy","timezone_policy"],"valid_operations":["overlap","containment","duration"],"invalid_inferences":["closed and half-open intervals are interchangeable"]},
    {"id":"semantic.duration","allowed_carriers":["carrier.duration","carrier.calendar_interval"],"required_qualifiers":["duration_kind","unit_or_calendar","precision"],"valid_operations":["sum_if_compatible","comparison"],"invalid_inferences":["calendar month equals fixed number of seconds"]},
    {"id":"semantic.coordinate","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["coordinate_reference_system","axis","unit","precision"],"valid_operations":["transform_crs","spatial_predicate"],"invalid_inferences":["distance before CRS and topology are declared"]},
    {"id":"semantic.geometry","allowed_carriers":["carrier.binary","carrier.utf8","carrier.extension"],"required_qualifiers":["geometry_type","coordinate_reference_system","dimensionality","validity_policy"],"valid_operations":["topological_predicate","projection","measurement"],"invalid_inferences":["coordinate equality implies geographic equivalence"]},
    {"id":"semantic.free_text","allowed_carriers":["carrier.utf8"],"required_qualifiers":["language","encoding","sensitivity"],"valid_operations":["display","exact_search","approved_text_statistics"],"invalid_inferences":["text is a stable category"]},
    {"id":"semantic.code","allowed_carriers":["carrier.utf8","carrier.signed_integer","carrier.unsigned_integer"],"required_qualifiers":["code_system","code_system_version","display_mapping"],"valid_operations":["equality","hierarchy_if_defined"],"invalid_inferences":["lexical order has domain meaning"]},
    {"id":"semantic.status","allowed_carriers":["carrier.utf8","carrier.signed_integer"],"required_qualifiers":["state_model","version","terminal_states"],"valid_operations":["transition_validation","frequency"],"invalid_inferences":["status is timeless"]},
    {"id":"semantic.boolean_assertion","allowed_carriers":["carrier.boolean"],"required_qualifiers":["assertion_definition","unknown_handling"],"valid_operations":["logical_composition"],"invalid_inferences":["false equals unknown or not observed"]},
    {"id":"semantic.treatment","allowed_carriers":["carrier.boolean","carrier.utf8","carrier.signed_integer"],"required_qualifiers":["strategy_definition","assignment_time","versions","adherence_semantics"],"valid_operations":["causal_contrast"],"invalid_inferences":["observed treatment is randomized"]},
    {"id":"semantic.outcome","allowed_carriers":["carrier.boolean","carrier.signed_integer","carrier.floating_point","carrier.decimal","carrier.timestamp"],"required_qualifiers":["outcome_definition","assessment_window","competing_events","ascertainment_method"],"valid_operations":["estimand_specific_analysis"],"invalid_inferences":["post-treatment measurement is baseline"]},
    {"id":"semantic.censoring_indicator","allowed_carriers":["carrier.boolean","carrier.utf8"],"required_qualifiers":["censoring_definition","censoring_time_role"],"valid_operations":["survival_analysis"],"invalid_inferences":["censoring is non-informative without assumption"]},
    {"id":"semantic.weight","allowed_carriers":["carrier.floating_point","carrier.decimal"],"required_qualifiers":["weight_type","target_population","normalization"],"valid_operations":["weighted_estimation"],"invalid_inferences":["frequency, probability and importance weights are interchangeable"]},
    {"id":"semantic.constraint","allowed_carriers":["carrier.utf8","carrier.extension"],"required_qualifiers":["expression_language","scope","hard_or_soft","version"],"valid_operations":["feasibility_evaluation"],"invalid_inferences":["soft penalty equals hard constraint"]},
    {"id":"semantic.objective","allowed_carriers":["carrier.utf8","carrier.extension"],"required_qualifiers":["expression_language","direction","units","tradeoff_policy","version"],"valid_operations":["optimization"],"invalid_inferences":["incommensurate objectives can be summed without weights"]}
  ],
  "observation_types": [
    {"id":"observation.entity","definition":"Continuant or conceptual object with stable identity across observations.","required_roles":["entity_id","entity_type","valid_time","provenance"]},
    {"id":"observation.event","definition":"Occurrence at a meaningful point or interval that may affect one or more entities.","required_roles":["event_id","event_type","event_time","related_entities","source","provenance"],"preferred_standard":"std_cloudevents"},
    {"id":"observation.state_snapshot","definition":"Values describing an entity as of a declared valid time and system time.","required_roles":["entity_id","state","valid_time","system_time","provenance"]},
    {"id":"observation.measurement","definition":"Measured quantity produced by an instrument, procedure, or calculation.","required_roles":["subject","quantity","unit","measurement_time","method","quality","provenance"]},
    {"id":"observation.transaction","definition":"Exchange or transfer with parties, items, quantities, amounts, and accounting time.","required_roles":["transaction_id","parties","items","quantities","amounts","occurred_at","provenance"]},
    {"id":"observation.relationship","definition":"Typed relation between entities with direction, qualifiers, and temporal validity.","required_roles":["source_entity","relation_type","target_entity","valid_time","provenance"]},
    {"id":"observation.interval_fact","definition":"Fact whose truth or applicability holds over a declared interval.","required_roles":["subject","predicate","value","valid_interval","system_time","provenance"]},
    {"id":"observation.experimental_assignment","definition":"Assignment of an experimental unit to a treatment strategy.","required_roles":["unit_id","experiment_id","strategy","assignment_time","mechanism","provenance"]},
    {"id":"observation.exposure","definition":"Evidence of what treatment, feature, message, or condition a unit actually experienced.","required_roles":["unit_id","exposure","occurred_at","context","provenance"]},
    {"id":"observation.lineage_assertion","definition":"Provenance relation among entities, activities, and responsible agents.","required_roles":["subject","predicate","object","activity","agent","time"],"preferred_standard":"std_w3c_prov"},
    {"id":"observation.policy_assertion","definition":"Machine-evaluable statement of permission, obligation, prohibition, retention, or purpose.","required_roles":["principal_or_data","rule","scope","effective_time","authority","version"]},
    {"id":"observation.finding","definition":"Versioned analytical assertion supported by evidence, method, and uncertainty.","required_roles":["finding_id","claim","evidence","method","as_of","uncertainty","provenance"]},
    {"id":"observation.decision","definition":"Selection among alternatives by a person, rule, or optimizer.","required_roles":["decision_id","alternatives","selection","objective_or_policy","decider","decided_at","evidence"]},
    {"id":"observation.action_receipt","definition":"Durable evidence that an intended action was attempted or applied.","required_roles":["intent_id","action","destination","attempted_at","status","idempotency_key","response","provenance"]}
  ],
  "analytical_structures": [
    {"id":"structure.relation","components":["typed attributes","keys","constraints","grain"],"invariants":["one declared grain","keys identify rows at that grain"]},
    {"id":"structure.event_log","components":["events","entities or cases","event ordering policy"],"invariants":["event identity stable","time role explicit","correction semantics explicit"]},
    {"id":"structure.object_event_graph","components":["events","objects","event-object links","object-object links","qualifiers"],"invariants":["many-to-many event-object relations preserved"],"preferred_standard":"std_ocel2"},
    {"id":"structure.sequence","components":["ordered observations","sequence identity","ordering key"],"invariants":["tie and partial-order policy explicit"]},
    {"id":"structure.trace","components":["case projection","ordered events","lifecycle mapping"],"invariants":["projection rule retained"]},
    {"id":"structure.time_series","components":["time index","values","frequency or irregularity","calendar"],"invariants":["timezone, interval, missingness and revision semantics explicit"]},
    {"id":"structure.panel","components":["entity index","time index","measures"],"invariants":["balancedness and entry/exit semantics explicit"]},
    {"id":"structure.cohort","components":["eligibility","index event","membership interval","follow-up","outcomes"],"invariants":["time zero and membership policy explicit"]},
    {"id":"structure.metric_cube","components":["measures","dimensions","coordinates","grain","aggregation algebra"],"invariants":["additivity and denominator rules explicit"]},
    {"id":"structure.tensor","components":["typed values","named axes","coordinate domains","sparsity"],"invariants":["axis meaning and order explicit"]},
    {"id":"structure.graph","components":["nodes","edges","node types","edge types","direction","weights"],"invariants":["identity, direction, multiplicity and temporal validity explicit"]},
    {"id":"structure.hypergraph","components":["nodes","hyperedges","incidence","qualifiers"],"invariants":["edge membership semantics explicit"]},
    {"id":"structure.spatial_vector","components":["geometry","attributes","coordinate reference system","topology"],"invariants":["CRS and validity policy explicit"]},
    {"id":"structure.spatial_raster","components":["grid","bands","extent","resolution","CRS","nodata semantics"],"invariants":["cell support, alignment and nodata semantics explicit"]},
    {"id":"structure.trajectory","components":["moving entity","ordered positions","time","interpolation"],"invariants":["sampling and interpolation policies explicit"]},
    {"id":"structure.survival_dataset","components":["unit","time origin","duration","event","censoring","competing risks","covariates"],"invariants":["risk-set and censoring semantics explicit"]},
    {"id":"structure.experiment_ledger","components":["units","assignment","exposure","outcomes","metrics","exclusions"],"invariants":["assignment and exposure distinguished","analysis population reproducible"]},
    {"id":"structure.causal_graph","components":["variables","directed relations","assumptions","selection"],"invariants":["causal and associational edges distinguished"]},
    {"id":"structure.process_model","components":["activities","states or places","transitions","routing","guards"],"invariants":["execution semantics declared"]},
    {"id":"structure.optimization_model","components":["decision variables","parameters","objectives","constraints","uncertainty"],"invariants":["units and domains compatible","feasibility semantics explicit"]},
    {"id":"structure.distribution","components":["support","parameters or samples","conditioning","uncertainty"],"invariants":["target quantity and population explicit"]},
    {"id":"structure.semantic_graph","components":["entities","dimensions","measures","joins","grains","policies"],"invariants":["join paths and measure algebra validated"]},
    {"id":"structure.lineage_graph","components":["entities","activities","agents","derivations","versions"],"invariants":["identity and responsibility explicit"],"preferred_standard":"std_w3c_prov"},
    {"id":"structure.query_plan","components":["typed operators","expressions","inputs","outputs","parameters"],"invariants":["operator semantics and type compatibility explicit"],"preferred_standard":"std_substrait"},
    {"id":"structure.policy_bundle","components":["rules","targets","principals","purposes","obligations","effective time"],"invariants":["conflict and default-deny behavior explicit"]}
  ],
  "taxonomy_shape_bindings": {
    "event_log":"structure.event_log",
    "object_event_graph":"structure.object_event_graph",
    "interaction_trace":"structure.trace",
    "entity_table":"structure.relation",
    "transaction_table":"structure.relation",
    "time_series":"structure.time_series",
    "panel":"structure.panel",
    "cohort":"structure.cohort",
    "metric_cube":"structure.metric_cube",
    "relation_graph":"structure.graph",
    "spatial_vector":"structure.spatial_vector",
    "spatial_raster":"structure.spatial_raster",
    "experiment_ledger":"structure.experiment_ledger",
    "process_model":"structure.process_model",
    "optimization_model":"structure.optimization_model",
    "semantic_graph":"structure.semantic_graph",
    "lineage_graph":"structure.lineage_graph",
    "policy_metadata":"structure.policy_bundle",
    "clinical_record":"structure.relation"
  },
  "classification_axes": {
    "value_semantics": ["carrier_type","composite_type","semantic_value_type","measurement_scale","unit_dimension","valid_operations"],
    "observation_semantics": ["observation_type","subject_role","predicate_or_measure","observation_unit","grain","population","collection_mechanism"],
    "identity": ["identifier_namespace","uniqueness_scope","stability","entity_resolution_policy","reference_integrity"],
    "temporality": ["event_time","valid_time","system_time","processing_time","point_or_interval","calendar","timezone","ordering","lateness","revision_policy"],
    "space": ["coordinate_reference_system","geometry_or_raster","topology","resolution","extent","spatial_support"],
    "relational_topology": ["cardinality","directionality","multiplicity","edge_qualifiers","hyperedge_membership","temporal_validity"],
    "measurement_quality": ["accuracy","precision","resolution","calibration","detection_limit","uncertainty","quality_flag","method"],
    "missingness": ["present","not_applicable","not_collected","unknown","withheld","below_detection","structural_zero","censored","not_yet_final"],
    "causal_role": ["treatment","outcome","confounder","mediator","instrument","effect_modifier","selection","collider","negative_control"],
    "uncertainty": ["none_declared","standard_error","confidence_interval","credible_interval","prediction_interval","distribution","scenario_set","bounds","sensitivity_range"],
    "mutability": ["append","snapshot_replace","upsert","correction","retraction","tombstone","change_data_capture","slowly_changing_dimension"],
    "finality": ["provisional","revised","final","superseded"],
    "provenance": ["source","agent","activity","method","code_version","configuration_version","input_versions","generated_at","derived_from"],
    "governance": ["owner","steward","classification","purpose","consent","lawful_basis","retention","residency","access_policy","minimum_group","release_policy"],
    "computation": ["batch_or_stream","latency","ordering_requirement","statefulness","determinism","incrementality","partitioning","resource_profile","failure_semantics"],
    "analytical_use": ["analytics_type","method_family","input_structure","output_structure","decision_proximity","human_role"]
  },
  "typing_rules": [
    {"id":"rule_storage_not_semantics","statement":"A carrier type never substitutes for a semantic value type."},
    {"id":"rule_null_not_missingness","statement":"Null or absence never substitutes for a missingness reason."},
    {"id":"rule_identifier_not_number","statement":"Numeric representation of an identifier never authorizes arithmetic or ordering."},
    {"id":"rule_unit_required","statement":"A physical quantity requires quantity kind, machine-readable unit, precision, and measurement method."},
    {"id":"rule_rate_denominator","statement":"A rate requires numerator, denominator, window, unit, and weighted aggregation behavior."},
    {"id":"rule_probability_contract","statement":"A probability requires target event, population, horizon, conditioning information, bounds, and calibration version."},
    {"id":"rule_score_not_probability","statement":"A score cannot be treated as a probability without an explicit validated calibration."},
    {"id":"rule_currency_context","statement":"A currency value requires currency, valuation date, price basis, and rounding policy."},
    {"id":"rule_temporal_roles","statement":"Event, valid, system, and processing time are distinct and cannot be silently substituted."},
    {"id":"rule_grain_required","statement":"Every relation, metric, join, and analytical result declares its grain."},
    {"id":"rule_additivity_required","statement":"Every measure declares whether and across which axes it is additive, semi-additive, weighted, or non-additive."},
    {"id":"rule_provisional_not_final","statement":"Provisional and revised observations retain revision history and cannot silently overwrite prior published state."},
    {"id":"rule_causal_role_explicit","statement":"Causal analyses explicitly classify treatment, outcome, adjustment variables, time zero, population, and estimand."},
    {"id":"rule_provenance_required","statement":"Every material analytical artifact identifies sources, producing activity, agent or system, method, configuration, and time."},
    {"id":"rule_vertical_extension","statement":"Domain packs may extend semantic value and observation subtypes, but must map them to canonical carriers, structures, axes, and operations."}
  ],
  "extension_protocol": {
    "new_domain_type_must_declare": ["id","parent_semantic_or_observation_type","definition","allowed_carriers","required_qualifiers","valid_operations","invalid_inferences","domain_pack_id","version","owner","source_ids","compatibility_policy","test_fixtures"],
    "forbidden_extensions": ["new primitive carrier without execution-engine support","semantic type defined only by display label","unit without dimension and conversion semantics","metric without grain and aggregation behavior","state without temporal validity","identifier without namespace"]
  }
}
