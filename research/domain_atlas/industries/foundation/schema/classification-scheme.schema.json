{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/industry-classification-scheme-v1.schema.json",
  "title": "Industry classification scheme or specialist overlay",
  "type": "object",
  "required": [
    "scheme_id",
    "scheme_series_id",
    "record_kind",
    "edition",
    "status",
    "name",
    "custodian",
    "scheme_kind",
    "concept_classified",
    "geographic_scope",
    "temporal_validity",
    "hierarchy",
    "assignment_rules",
    "atlas_role",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "scheme_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"},
    "scheme_series_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"},
    "record_kind": {"const": "classification_scheme"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {
      "enum": [
        "operational",
        "endorsed_publication_forthcoming",
        "final_transitioning",
        "superseded",
        "draft",
        "candidate"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "custodian": {"type": "string", "minLength": 1},
    "scheme_kind": {
      "enum": [
        "economic_activity",
        "product",
        "provider",
        "function_or_purpose",
        "specialist_activity_overlay",
        "regulatory_line",
        "criticality_overlay",
        "statistical_model"
      ]
    },
    "concept_classified": {"type": "string", "minLength": 1},
    "statistical_unit": {"type": ["string", "null"]},
    "geographic_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "temporal_validity": {
      "type": "object",
      "required": ["edition_label", "valid_from", "valid_to"],
      "properties": {
        "edition_label": {"type": "string", "minLength": 1},
        "valid_from": {"type": ["string", "null"]},
        "valid_to": {"type": ["string", "null"]},
        "transition_note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "required": ["levels", "code_semantics"],
      "properties": {
        "levels": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "code_semantics": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assignment_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "atlas_role": {
      "enum": [
        "global_activity_reference_spine",
        "jurisdictional_activity_view",
        "specialist_analytical_overlay",
        "adjacent_cross_classification",
        "metamodel_evidence"
      ]
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "official_crosswalks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_scheme_edition_id", "source_ref", "availability"],
        "properties": {
          "target_scheme_edition_id": {"type": "string"},
          "source_ref": {"type": "string"},
          "availability": {"enum": ["published", "announced", "not_found", "not_applicable"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
