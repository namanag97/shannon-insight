{
  "$id": "https://san.local/domain-atlas/security-privacy-trust/library-boundaries.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "cross_platform_map": {
      "additionalProperties": false,
      "properties": {
        "consumption": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "governance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "persistence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pipelines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "runtime": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_occurrences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "types_shapes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "source_occurrences",
        "types_shapes",
        "pipelines",
        "persistence",
        "runtime",
        "governance",
        "lineage",
        "consumption"
      ],
      "type": "object"
    },
    "domain": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "effect_class": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "library_id": {
      "minLength": 3,
      "type": "string"
    },
    "must_not_own": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "owns": {
      "minLength": 1,
      "type": "string"
    },
    "public_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "required_receipts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "enum": [
        "sourced_candidate",
        "open_candidate_gap"
      ],
      "type": "string"
    }
  },
  "required": [
    "cross_platform_map",
    "domain",
    "edition",
    "effect_class",
    "evidence_source_ids",
    "library_id",
    "must_not_own",
    "owns",
    "public_types",
    "required_receipts",
    "status"
  ],
  "title": "Security Privacy Trust library-boundaries candidate",
  "type": "object"
}
