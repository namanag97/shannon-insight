{
  "$id": "https://san.example/spec/representation_codec_boundary-adjudication-metamodel-v0.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_kinds": {
    "architecture_pattern": {
      "definition": "Recurring packaging or deployment shape; not a product or semantic owner.",
      "kind": "architecture_pattern"
    },
    "capability": {
      "definition": "Typed operation provided under a semantic contract.",
      "kind": "capability"
    },
    "control_component": {
      "definition": "Runtime or policy component inside a consuming product.",
      "kind": "control_component"
    },
    "implementation": {
      "definition": "Observed unqualified implementation or provider.",
      "kind": "implementation"
    },
    "neighbor": {
      "definition": "Adjacent owner imported through a typed boundary.",
      "kind": "neighbor"
    },
    "semantic_contract": {
      "definition": "Owner of representation identity, laws, decisions and refusals.",
      "kind": "semantic_contract"
    },
    "standard": {
      "definition": "Editioned external representation specification.",
      "kind": "standard"
    }
  },
  "binding_phases": [
    "authoring",
    "compile_time",
    "deployment_time",
    "runtime",
    "qualification_time"
  ],
  "contract_id": "contract.product_adjudication.representation_codec_boundary.v0_1_0",
  "edition": 1,
  "non_collapse_laws": [
    "semantic type != carrier != serialization != framing != layout != column encoding != compression != codec != container",
    "algorithm/format identity != provider identity != qualified offer != runtime occurrence",
    "lossless claim != proved equality; lossy configuration != accepted loss authority",
    "deterministic serialization != universal canonicalization != business identity",
    "codec library/runtime component != independently adopted enterprise product",
    "optional models or agents cannot select providers, authorize loss, bypass validation or own execution receipts"
  ],
