{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/data-modality-gap-audit/schema-posture-audit.schema.json",
  "type": "object",
  "required": ["posture_id", "input_label", "normalized_postures", "is_modality", "structure_absent", "audit_rule", "examples", "evidence_refs"],
  "properties": {
    "posture_id": {"type": "string", "pattern": "^POSTURE-[0-9]{3}$"},
    "input_label": {"enum": ["structured", "semi-structured", "so-called unstructured"]},
    "normalized_postures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["strongly_schema_bound", "self_describing", "schema_on_read", "mixed", "weakly_declared", "opaque"]}},
    "is_modality": {"const": false},
    "structure_absent": {"const": false},
    "audit_rule": {"type": "string", "minLength": 30},
    "examples": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
