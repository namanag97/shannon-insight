{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/connector-capability.schema.json",
  "title": "Connector capability and assurance declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "source_class_ids", "protocol", "versions", "license", "operations", "delivery", "schema", "temporal", "security", "limits", "observability", "conformance_receipts"],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 3},
    "source_class_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^source\\."}},
    "protocol": {"type": "string"},
    "versions": {"type": "object", "required": ["protocol", "implementation", "minimum_source", "maximum_tested_source"], "additionalProperties": false, "properties": {"protocol": {"type": "string"}, "implementation": {"type": "string"}, "minimum_source": {"type": "string"}, "maximum_tested_source": {"type": "string"}}},
    "license": {"type": "object", "required": ["spdx_or_policy", "redistribution", "support_status"], "additionalProperties": false, "properties": {"spdx_or_policy": {"type": "string"}, "redistribution": {"type": "string"}, "support_status": {"type": "string"}}},
    "operations": {"type": "object", "required": ["discovery", "read", "write", "change"], "additionalProperties": true},
    "delivery": {"type": "object", "required": ["guarantee", "ordering_scope", "checkpoint", "resume", "replay", "backfill", "deduplication", "transaction_boundary"], "additionalProperties": true},
    "schema": {"type": "object", "required": ["discovery", "inference", "drift", "compatibility", "unknown_fields", "deprecation"], "additionalProperties": true},
    "temporal": {"type": "object", "required": ["event_time", "recorded_time", "cursor_time", "watermark", "late_data", "revision", "tombstone"], "additionalProperties": true},
    "security": {"type": "object", "required": ["credential_reference_only", "authentication", "authorization", "encryption", "network_boundary", "secret_rotation", "audit"], "additionalProperties": true},
    "limits": {"type": "object", "required": ["rate", "quota", "page", "payload", "concurrency", "retention", "query_cost"], "additionalProperties": true},
    "observability": {"type": "object", "required": ["health", "metrics", "logs", "traces", "lineage", "dead_letter", "retry", "runbook", "owner"], "additionalProperties": true},
    "conformance_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_id", "result", "executed_at", "artifact_ref"],
        "additionalProperties": false,
        "properties": {
          "test_id": {"type": "string", "pattern": "^verify\\."},
          "result": {"enum": ["pass", "fail", "not_supported", "not_authorized", "inconclusive"]},
          "executed_at": {"type": "string", "format": "date-time"},
          "artifact_ref": {"type": "string"}
        }
      }
    }
  }
}
