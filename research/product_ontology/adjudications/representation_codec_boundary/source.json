  "negative_scope": "Does not own semantic data meaning, storage/product lifecycle, security authority, runtime scheduling or independent enterprise product outcomes.",
  "negative_tests": [
    {
      "expected_result": "retain library/kernel semantics and optional runtime component",
      "prohibited_claim": "every encode/decode operation is an enterprise product",
      "test_id": "negative.rcb.codec_product"
    },
    {
      "expected_result": "bind an exact qualified version/profile/target offer",
      "prohibited_claim": "algorithm name selects a provider",
      "test_id": "negative.rcb.algorithm_provider"
    },
    {
      "expected_result": "import semantic type and domain contracts",
      "prohibited_claim": "file format owns business meaning",
      "test_id": "negative.rcb.format_semantics"
    },
    {
      "expected_result": "validate exact carrier and format evidence",
      "prohibited_claim": "file suffix proves type or codec",
      "test_id": "negative.rcb.suffix_type"
    },
    {
      "expected_result": "bind a canonical profile and equivalence scope",
      "prohibited_claim": "deterministic serialization is universally canonical",
      "test_id": "negative.rcb.deterministic_canonical"
    },
    {
      "expected_result": "keep content identity and domain identity distinct",
      "prohibited_claim": "digest of bytes is business identity",
      "test_id": "negative.rcb.digest_identity"
    },
    {
      "expected_result": "retain integrity-detection and authenticated-issuer contracts separately",
      "prohibited_claim": "checksum is a signature",
      "test_id": "negative.rcb.checksum_signature"
    },
    {
      "expected_result": "type compression and layout independently",
      "prohibited_claim": "compression algorithm is physical layout",
      "test_id": "negative.rcb.compression_layout"
    },
    {
      "expected_result": "preserve the transform pipeline stages",
      "prohibited_claim": "column encoding is a general compressor",
      "test_id": "negative.rcb.column_codec"
    },
    {
      "expected_result": "declare each access trait and prerequisites",
      "prohibited_claim": "streamable means splittable or random access",
      "test_id": "negative.rcb.stream_random"
    },
    {
      "expected_result": "prove independent decode units and dependencies",
      "prohibited_claim": "range-readable carrier makes compressed content random access",
      "test_id": "negative.rcb.range_random"
    },
    {
      "expected_result": "bind exact dictionary artifact and lifecycle",
      "prohibited_claim": "dictionary ID guarantees dictionary availability or identity",
      "test_id": "negative.rcb.dictionary_inline"
    },
    {
      "expected_result": "require finite loss profile, authority and decoded-output oracle",
      "prohibited_claim": "lossy mode can be selected by cost optimization alone",
      "test_id": "negative.rcb.lossy_default"
    },
    {
      "expected_result": "run the declared equality oracle over qualified profiles",
      "prohibited_claim": "provider lossless label proves equality",
      "test_id": "negative.rcb.lossless_name"
    },
    {
      "expected_result": "emit typed loss or refuse",
      "prohibited_claim": "transcode may drop unsupported semantics silently",
      "test_id": "negative.rcb.transcode_silent"
    },
    {
      "expected_result": "qualify profile, memory space, limits, cancellation and result equivalence",
      "prohibited_claim": "GPU codec is compatible because the algorithm name matches",
      "test_id": "negative.rcb.gpu_name"
    },
    {
      "expected_result": "model expansion, CPU, access and latency trade-offs",
      "prohibited_claim": "more compression layers always improve cost",
      "test_id": "negative.rcb.double_compress"
    },
    {
      "expected_result": "require executable conformance and resource evidence",
      "prohibited_claim": "official docs qualify provider behavior",
      "test_id": "negative.rcb.provider_docs"
    },
    {
      "expected_result": "compile typed intent and require authority/qualification",
      "prohibited_claim": "agent may choose lossy settings or provider from prose",
      "test_id": "negative.rcb.agent_select"
    },
    {
      "expected_result": "model exact codec/loss method without changing product boundaries",
      "prohibited_claim": "AI codec creates a new representation product",
      "test_id": "negative.rcb.ai_codec"
    }
  ],
  "non_collapse_laws": [
    "semantic type != carrier != serialization != framing != layout != column encoding != compression != codec != container",
    "algorithm/format identity != provider identity != qualified offer != runtime occurrence",
    "lossless claim != proved equality; lossy configuration != accepted loss authority",
    "deterministic serialization != universal canonicalization != business identity",
    "codec library/runtime component != independently adopted enterprise product",
    "optional models or agents cannot select providers, authorize loss, bypass validation or own execution receipts"
  ],
