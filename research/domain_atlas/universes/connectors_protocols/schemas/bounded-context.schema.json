{
  "$id": "https://san.example/domain-atlas/connectors-protocols/context_id.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "commands": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "context_id": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "decision_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "definition": {
      "minLength": 20,
      "type": "string"
    },
    "does_not_own": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "events": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "invariants": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "minLength": 3,
      "type": "string"
    },
    "owns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "refusals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "hypothesis",
        "test_fixture",
        "deprecated_candidate",
        "open"
      ]
    }
  },
  "required": [
    "context_id",
    "edition",
    "status",
    "name",
    "definition",
    "owns",
    "does_not_own",
    "aggregates",
    "invariants",
    "commands",
    "events",
    "refusals",
    "decision_refs",
    "evidence_refs",
    "gaps"
  ],
  "title": "Connector/protocol bounded-context candidate",
  "type": "object"
}
