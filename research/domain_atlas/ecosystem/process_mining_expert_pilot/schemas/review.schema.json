{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/process-mining-expert-review-v0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "raw_claim", "status", "candidate_artifact_ids", "finding", "source_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^review\\."},
    "raw_claim": {"type": "string", "minLength": 3},
    "status": {"type": "string", "minLength": 3},
    "candidate_artifact_ids": {"type": "array", "items": {"type": "string", "pattern": "^art\\."}, "uniqueItems": true},
    "finding": {"type": "string", "minLength": 20},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src\\."}, "uniqueItems": true}
  }
}
