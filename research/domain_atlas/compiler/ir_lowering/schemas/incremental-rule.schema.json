{
  "$defs": {
    "id": {
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_:-]+)+$",
      "type": "string"
    },
    "refs": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "uniqueItems": true
    },
    "strings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change_key": {
      "type": "string"
    },
    "edition": {
      "type": "integer"
    },
    "fingerprint_contract": {
      "type": "string"
    },
    "incremental_rule_id": {
      "$ref": "#/$defs/id"
    },
    "invalidates": {
      "$ref": "#/$defs/strings"
    },
    "receipt": {
      "type": "string"
    },
    "reuse_gate": {
      "type": "string"
    },
    "source_refs": {
      "$ref": "#/$defs/refs"
    },
    "stable_key_contract": {
      "type": "string"
    },
    "status": {
      "const": "candidate"
    }
  },
  "required": [
    "incremental_rule_id",
    "edition",
    "status",
    "change_key",
    "invalidates",
    "stable_key_contract",
    "fingerprint_contract",
    "reuse_gate",
    "receipt",
    "source_refs"
  ],
  "title": "Incremental recompilation rule",
  "type": "object"
}
