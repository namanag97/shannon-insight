{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/compiler-decision-point-v0.1.0.schema.json",
  "title": "Explicit configurable decision point",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "edition", "status", "owner_context_ref", "question", "value_contract", "allowed_values", "binding_phase", "authority_ref", "default_law", "default_value", "constraints", "conflicts", "implications", "affects_contracts", "evidence_required", "change_semantics", "gaps"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^decision\\.[a-z0-9_.-]+$"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"enum": ["hypothesis", "declared", "reviewed", "adjudicated", "deprecated"]},
    "owner_context_ref": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "value_contract": {"type": "string", "minLength": 1},
    "allowed_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "binding_phase": {"enum": ["authoring", "intent_resolution", "semantic_closure", "analytical_design", "observation_planning", "logical_planning", "assurance_insertion", "physical_binding", "deployment_binding", "runtime_reconciliation", "evidence_verification", "product_packaging"]},
    "authority_ref": {"type": "string", "minLength": 1},
    "default_law": {"enum": ["forbidden", "explicit_safe_constant", "inherited_from_owned_context", "provider_derived_with_receipt", "runtime_observed_with_receipt"]},
    "default_value": {"type": ["string", "number", "integer", "boolean", "null"]},
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "implications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affects_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "change_semantics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

