{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/data-shape-bounded-context-candidate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_id", "name", "status", "sovereign_question", "owns", "inside", "outside", "invariants", "neighbors", "compiler_surfaces", "evidence_refs", "open_questions"],
  "properties": {
    "context_id": {"type": "string", "pattern": "^bc\\.[a-z0-9_.-]+$"},
    "name": {"type": "string"},
    "status": {"const": "candidate"},
    "sovereign_question": {"type": "string", "minLength": 15},
    "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "inside": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outside": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "neighbors": {"type": "array", "items": {"type": "object", "required": ["context_id", "relationship"], "properties": {"context_id": {"type": "string"}, "relationship": {"enum": ["upstream", "downstream", "partnership", "anti_corruption_layer", "published_language", "open_host_service"]}}, "additionalProperties": false}},
    "compiler_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DSS-[0-9]{3}$"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
