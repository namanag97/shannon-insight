{
  "$id": "https://san.example/spec/family-source-authority-decision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RATIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_claim_refs": {
            "minItems": 1
          },
          "ratifier_refs": {
            "minItems": 1
          },
          "record_authority_refs": {
            "minItems": 1
          },
          "schema_authority_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "UNRESOLVED"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_items": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "adopted_fields": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "conflicts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "decision": {
      "enum": [
        "ADOPT_CANONICAL",
        "ADOPT_WITH_TRANSFORM",
        "SPLIT",
        "MERGE",
        "REPLACE",
        "REJECT",
        "UNRESOLVED"
      ]
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_claim_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "family_id": {
      "minLength": 1,
      "type": "string"
    },
    "ratifier_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "record_authority_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "record_kind": {
      "const": "family_source_authority_decision"
    },
    "rejected_fields": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_authority_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "RATIFIED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "transformations": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "record_kind",
    "decision_id",
    "edition",
    "family_id",
    "source_path",
    "source_digest",
    "decision",
    "schema_authority_refs",
    "record_authority_refs",
    "evidence_claim_refs",
    "adopted_fields",
    "rejected_fields",
    "transformations",
    "conflicts",
    "unresolved_items",
    "ratifier_refs",
    "status"
  ],
  "type": "object"
}
