{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/process-mining-expert-v0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "orcid", "expertise_claims", "contribution_ids", "role_warning"],
  "properties": {
    "id": {"type": "string", "pattern": "^expert\\."},
    "name": {"type": "string", "minLength": 3},
    "orcid": {"type": ["string", "null"]},
    "expertise_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "contribution_ids": {"type": "array", "items": {"type": "string", "pattern": "^art\\."}, "uniqueItems": true},
    "role_warning": {"type": "string", "minLength": 20}
  }
}
