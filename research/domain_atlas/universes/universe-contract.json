    "enumeration_saturation",
    "primary_source_support",
    "operation_surface",
    "semantic_owner_uniqueness",
    "context_mapping",
    "compiler_mapping",
    "machine_implementation",
    "provider_conformance",
    "two_unrelated_verticals",
    "independent_review",
    "recurring_freshness"
  ],
  "extension_law": "A new record may extend an open universe without changing the compiler's closed metamodel; unresolved semantics or capabilities produce a typed gap.",
  "automation_modality_contract": {
    "default_posture": "DETERMINISTIC_CORE_ONLY",
    "use_site_postures": ["PROHIBITED", "OPTIONAL", "REQUIRED_BY_INTENT", "UNDETERMINED"],
    "qualified_modalities": [
      "human_procedure",
      "deterministic_rules_or_algorithm",
      "operations_research_or_statistics",
      "classical_predictive_model",
      "generative_model",
      "tool_using_agent",
      "hybrid"
    ],
    "selection_law": "Select a modality only after the use site's owned operation, typed inputs and outputs, invariants, authority, budgets, evidence requirements and acceptance oracle are fixed.",
    "non_authority_law": "A generated output or agent plan is a proposal; it cannot define domain meaning, validate itself, grant authority, perform a protected effect or issue its own execution receipt.",
    "removal_law": "Removing every optional model or agent provider leaves a valid deterministic core plan or produces an explicit capability_unavailable gap; it never weakens a law or fabricates a result.",
    "naming_law": "Adding a model or agent does not create an AI-prefixed copy of an existing domain, bounded context, capability or product.",
    "hard_work_law": "Model or agent assistance does not discharge deterministic enumeration, typing, constraint solving, policy evaluation, effect control, verification, conformance, qualification or evidence work."
  },
  "forbidden_core_dependencies": ["llm", "large_language_model", "prompt", "rag", "agent_memory", "generative_model"],
  "extension_law_model_agent": "Adding or removing the optional model/agent extension must not change core domain meanings, deterministic binding, authorization, effect control or proof obligations."
}
