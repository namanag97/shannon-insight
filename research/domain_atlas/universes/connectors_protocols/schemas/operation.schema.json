{
  "$id": "https://san.example/domain-atlas/connectors-protocols/operation_id.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cancellation": {
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "effect_kind": {
      "enum": [
        "pure",
        "read",
        "write",
        "command",
        "subscription",
        "control",
        "probe"
      ]
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "failure_modes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "idempotency": {
      "type": "string"
    },
    "input_contract": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "output_contract": {
      "type": "object"
    },
    "owner_context_ref": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "postconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "preconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "receipts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "hypothesis",
        "test_fixture",
        "deprecated_candidate",
        "open"
      ]
    }
  },
  "required": [
    "operation_id",
    "edition",
    "status",
    "name",
    "owner_context_ref",
    "effect_kind",
    "input_contract",
    "output_contract",
    "preconditions",
    "postconditions",
    "failure_modes",
    "idempotency",
    "cancellation",
    "receipts",
    "evidence_refs"
  ],
  "title": "Typed connector operation candidate",
  "type": "object"
}
