{
  "$id": "https://shannon-insight.local/schemas/qor/bounded-context-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_candidates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "candidate_note": {
      "minLength": 1,
      "type": "string"
    },
    "capability_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "context_id": {
      "pattern": "^qor\\.context\\.",
      "type": "string"
    },
    "cross_plane_ref": {
      "minLength": 1,
      "type": "string"
    },
    "decision_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "edition": {
      "type": "integer"
    },
    "excludes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invariant_ref": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "operation_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^qor\\.src\\.",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sovereign_distinctions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "researched_candidate_not_adjudicated"
    }
  },
  "required": [
    "context_id",
    "edition",
    "status",
    "name",
    "purpose",
    "aggregate_candidates",
    "owns",
    "excludes",
    "sovereign_distinctions",
    "capability_refs",
    "operation_refs",
    "decision_refs",
    "invariant_ref",
    "source_refs",
    "cross_plane_ref",
    "candidate_note"
  ],
  "title": "Quality bounded-context candidate",
  "type": "object"
}
