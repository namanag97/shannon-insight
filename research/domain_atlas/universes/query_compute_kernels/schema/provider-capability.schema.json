{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration_decisions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "conformance_requirements": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "context_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "guarantees": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "invalidation_triggers": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kernel_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "offered_capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "operation_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "provider_capability_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "semantic_contract_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "capability_class"
    },
    "supported_target_classes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "provider_capability_id",
    "edition",
    "status",
    "name",
    "context_refs",
    "offered_capabilities",
    "semantic_contract_refs",
    "operation_refs",
    "kernel_refs",
    "supported_target_classes",
    "guarantees",
    "limits",
    "configuration_decisions",
    "conformance_requirements",
    "evidence_refs",
    "invalidation_triggers",
    "gaps"
  ],
  "title": "Provider capability class",
  "type": "object"
}
