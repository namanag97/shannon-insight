{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/provider-product-offer.schema.json",
  "title": "Provider/product documented source offer",
  "description": "Describes what a provider product documents it can expose. It is not a deployment occurrence, access-surface observation, connector qualification or successful extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["offer_id","provider","product","edition_or_version_envelope","source_class_refs","documented_object_families","documented_access_surface_kinds","evidence_refs","status","non_collapse"],
  "properties": {
    "offer_id": {"type":"string","pattern":"^source-offer\\."},
    "provider": {"type":"string","minLength":1},
    "product": {"type":"string","minLength":1},
    "edition_or_version_envelope": {"type":"string","minLength":1},
    "source_class_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^source\\."}},
    "documented_object_families": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "documented_access_surface_kinds": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "evidence_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "status": {"enum":["DOCUMENTED_OFFER_CANDIDATE","DOCUMENTED_OFFER_REVIEWED","RETIRED_OR_SUPERSEDED"]},
    "non_collapse": {"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string"}},
    "completion_claim": {"type":"boolean","const":false}
  }
}
