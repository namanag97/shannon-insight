{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/persistence-bounded-context-v0.1.0.schema.json",
  "title": "Persistence and lakehouse bounded-context candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id", "edition", "status", "family_id", "name", "vision",
    "boundary_question", "inside", "outside", "ubiquitous_terms", "invariants",
    "commands", "events", "refusals", "state_machine", "time_model",
    "concurrency_model", "authority", "upstream_context_refs", "downstream_context_refs",
    "decision_refs", "capability_refs", "evidence_refs", "compiler_implications",
    "gaps"
  ],
  "properties": {
    "context_id": {"type": "string", "pattern": "^persistence\\.context\\.[a-z0-9_.-]+$"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate_not_adjudicated", "adjudicated", "deprecated"]},
    "family_id": {"type": "string", "pattern": "^persistence\\.family\\.[a-z0-9_.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "vision": {"type": "string", "minLength": 1},
    "boundary_question": {"type": "string", "minLength": 1},
    "inside": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "outside": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "ubiquitous_terms": {"type": "array", "items": {"type": "object", "required": ["term", "meaning"], "properties": {"term": {"type": "string"}, "meaning": {"type": "string"}}, "additionalProperties": false}, "minItems": 2},
    "invariants": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
    "commands": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "events": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "refusals": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "state_machine": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "time_model": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "concurrency_model": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "authority": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "upstream_context_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "downstream_context_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capability_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "compiler_implications": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "gaps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}
