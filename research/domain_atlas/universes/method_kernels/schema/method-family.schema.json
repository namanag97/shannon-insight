{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/method-family-contract-v0.1.0.schema.json",
  "title": "Provider-neutral analytical method-family contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_family_id", "edition", "status", "name", "domain_family", "definition",
    "owner_context_ref", "practice_refs", "study_design_contract", "estimand_contract",
    "input_contracts", "assumptions", "formula_model_contract", "estimator_contract",
    "output_contracts", "uncertainty_contract", "evaluation_contract", "result_states",
    "artifact_lifecycle", "algorithm_requirements", "kernel_requirements", "decision_refs",
    "or_bridge_refs", "evidence_refs", "llm_dependency", "gaps"
  ],
  "properties": {
    "method_family_id": {"type": "string", "pattern": "^method_family\\.[a-z0-9_]+\\.[a-z0-9_]+$"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"enum": ["hypothesis", "sourced_candidate", "reviewed", "adjudicated", "deprecated"]},
    "name": {"type": "string", "minLength": 1},
    "domain_family": {"enum": ["descriptive", "inferential", "experimental", "causal", "forecasting", "anomaly_change", "process", "data_quality", "reliability", "queue_simulation", "operations_research_bridge", "graph", "spatial", "text_search", "signal", "image", "semantic_metric"]},
    "definition": {"type": "string", "minLength": 1},
    "owner_context_ref": {"type": "string", "minLength": 1},
    "practice_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "study_design_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "estimand_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "input_contracts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "formula_model_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "estimator_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "output_contracts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "uncertainty_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "evaluation_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "result_states": {"type": "array", "items": {"enum": ["valid", "invalid_input", "not_identified", "assumptions_unmet", "unsupported", "not_converged", "numerically_suspect", "resource_exhausted", "cancelled", "inconclusive"]}, "minItems": 2, "uniqueItems": true},
    "artifact_lifecycle": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "algorithm_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "kernel_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "or_bridge_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "llm_dependency": {"const": "none"},
    "gaps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}

