{
  "$id": "https://san.example/spec/provider-target/context_id-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "pattern": "^[a-z][a-z0-9_.-]+$",
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "inside": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "outside": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "context_id",
    "edition",
    "status",
    "name",
    "inside",
    "outside",
    "invariants",
    "evidence_refs",
    "gaps"
  ],
  "title": "Provider-target bounded-context candidate",
  "type": "object"
}
