{
  "$id": "https://shannon-insight.local/schemas/qor/decision-point.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affects_operations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "allowed_value_kinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "binding_phase": {
      "minLength": 1,
      "type": "string"
    },
    "decision_id": {
      "pattern": "^qor\\.decision\\.",
      "type": "string"
    },
    "default_law": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "type": "integer"
    },
    "evidence_required": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^qor\\.src\\.",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "researched_candidate_not_adjudicated"
    }
  },
  "required": [
    "decision_id",
    "edition",
    "status",
    "owner_context",
    "question",
    "binding_phase",
    "allowed_value_kinds",
    "default_law",
    "evidence_required",
    "affects_operations",
    "source_refs"
  ],
  "title": "Quality compiler decision point",
  "type": "object"
}
