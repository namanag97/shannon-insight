{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shannon.invalid/schema/corpus-build-package-contract-v1.json",
  "title": "Corpus build package contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "root", "package_kind", "authority_class", "dependency_refs", "input_selectors", "uncontracted_input_surfaces", "build_commands", "validate_commands", "rebuild_policy", "write_policy", "execution_enabled", "fixed_point_group", "negative_claims"],
  "properties": {
    "package_id": {"type": "string", "pattern": "^package\\.[a-z0-9_]+$"},
    "root": {"type": "string", "pattern": "^research/"},
    "package_kind": {"enum": ["authored_source", "deterministic_projection", "fixed_point_projection", "aggregate_validator", "execution_campaign", "historical_snapshot"]},
    "authority_class": {"enum": ["structural_metadata", "research_candidate", "proposed_unratified", "execution_evidence_not_qualification", "historical_evidence"]},
    "dependency_refs": {"type": "array", "items": {"type": "string", "pattern": "^package\\."}, "uniqueItems": true},
    "input_selectors": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "uncontracted_input_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "build_commands": {"$ref": "#/$defs/commands"},
    "validate_commands": {"$ref": "#/$defs/commands"},
    "rebuild_policy": {"enum": ["on_declared_input_change", "repository_fixed_point", "validate_only", "manual_evidence_occurrence", "immutable_never_rebuild"]},
    "write_policy": {"enum": ["package_root_only", "declared_output_paths_only", "read_only"]},
    "execution_enabled": {"type": "boolean"},
    "fixed_point_group": {"type": ["string", "null"]},
    "negative_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {"type": "string"}
      }
    }
  }
}
