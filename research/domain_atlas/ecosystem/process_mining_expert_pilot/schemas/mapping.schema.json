{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/process-mining-contribution-mapping-v0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "artifact_id", "mapping_kind", "canonical_target", "relation", "decision_or_proof", "primary_source_ids", "adjudication_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^map\\."},
    "artifact_id": {"type": "string", "pattern": "^art\\."},
    "mapping_kind": {"enum": ["practice", "method", "operation", "representation", "kernel", "library", "compiler_node"]},
    "canonical_target": {"type": "string", "minLength": 8},
    "relation": {"enum": ["candidate_realizes", "candidate_refines"]},
    "decision_or_proof": {"type": "string", "minLength": 3},
    "primary_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src\\."}, "uniqueItems": true},
    "adjudication_status": {"enum": ["candidate_requires_global_binding", "reference_only_no_binding", "excluded_noncore_reference"]}
  }
}
