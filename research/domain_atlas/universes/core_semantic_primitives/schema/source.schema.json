{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "title", "publisher", "source_kind", "url", "year", "family_refs", "authority_scope", "accessed"],
  "properties": {
    "id": {"type": "string", "pattern": "^source\\.csp\\."},
    "status": {"const": "reference"},
    "title": {"type": "string", "minLength": 4},
    "publisher": {"type": "string", "minLength": 2},
    "source_kind": {"type": "string", "minLength": 3},
    "url": {"type": "string", "format": "uri"},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2026},
    "family_refs": {"type": "array", "minItems": 1, "items": {"enum": ["intent", "identity", "time", "quantity", "authority", "decision"]}},
    "authority_scope": {"type": "string", "minLength": 10},
    "accessed": {"type": "string", "format": "date"}
  }
}
