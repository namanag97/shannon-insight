{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "impact_on_metamodel": {
      "type": "string"
    },
    "innovation_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "non_llm": {
      "const": true
    },
    "status": {
      "const": "evidence_backed_candidate"
    },
    "year": {
      "maximum": 2026,
      "minimum": 2021,
      "type": "integer"
    }
  },
  "required": [
    "innovation_id",
    "edition",
    "status",
    "name",
    "year",
    "claim",
    "impact_on_metamodel",
    "non_llm",
    "evidence_refs",
    "limitations",
    "gaps"
  ],
  "title": "Non-LLM innovation record",
  "type": "object"
}
