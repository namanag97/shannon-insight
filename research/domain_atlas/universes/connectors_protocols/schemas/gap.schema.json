{
  "$id": "https://san.example/domain-atlas/connectors-protocols/gap_id.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocking": {
      "type": "boolean"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "gap_id": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "gap_kind": {
      "type": "string"
    },
    "known": {
      "type": "string"
    },
    "prohibited_assumption": {
      "type": "string"
    },
    "resolution_condition": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "hypothesis",
        "test_fixture",
        "deprecated_candidate",
        "open"
      ]
    },
    "subject_ref": {
      "pattern": "^[a-z][a-z0-9_.:-]+$",
      "type": "string"
    },
    "unknown": {
      "type": "string"
    }
  },
  "required": [
    "gap_id",
    "edition",
    "status",
    "subject_ref",
    "gap_kind",
    "blocking",
    "known",
    "unknown",
    "resolution_condition",
    "prohibited_assumption",
    "evidence_refs"
  ],
  "title": "Open connector/protocol research gap",
  "type": "object"
}
