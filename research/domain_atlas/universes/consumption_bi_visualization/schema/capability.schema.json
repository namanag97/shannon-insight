{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_live_posture": {
      "minLength": 1,
      "type": "string"
    },
    "capability_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "context_ref": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "decision_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "determinism": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "effects": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "family": {
      "minLength": 1,
      "type": "string"
    },
    "information_loss": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "typed_operation"
    },
    "meaning": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "postconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "preconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "refusals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "candidate"
    },
    "typed_inputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "typed_outputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "capability_id",
    "edition",
    "status",
    "context_ref",
    "family",
    "kind",
    "name",
    "meaning",
    "typed_inputs",
    "typed_outputs",
    "preconditions",
    "postconditions",
    "effects",
    "determinism",
    "information_loss",
    "batch_live_posture",
    "decision_refs",
    "evidence_refs",
    "refusals"
  ],
  "title": "Typed consumption capability",
  "type": "object"
}
