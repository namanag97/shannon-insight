{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_ref": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "decision_receipt": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "default_policy": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "options": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "required_inputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "candidate"
    }
  },
  "required": [
    "decision_id",
    "edition",
    "status",
    "context_ref",
    "question",
    "options",
    "required_inputs",
    "default_policy",
    "decision_receipt",
    "evidence_refs"
  ],
  "title": "Consumption decision point",
  "type": "object"
}
