{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://san.example/domain-atlas/governed-data-cut.schema.json",
  "title":"Governed data cut",
  "description":"Immutable evidence-bearing identity for the exact source records/time interval made available to downstream analytics. A successful connector run is not itself a governed data cut.",
  "type":"object",
  "additionalProperties":false,
  "required":["cut_id","occurrence_ref","acquisition_plan_ref","source_class_refs","object_scope","schema_identity","time_bounds","position_bounds","record_identity","completeness","deletions_and_corrections","authority_refs","lineage","evidence_refs","created_at","status","non_collapse"],
  "properties":{
    "cut_id":{"type":"string","pattern":"^governed-cut\\."},
    "occurrence_ref":{"type":"string","pattern":"^source-occurrence\\."},
    "acquisition_plan_ref":{"type":"string","pattern":"^acquisition-plan\\."},
    "source_class_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^source\\."}},
    "object_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "schema_identity":{"type":"object","required":["schema_digest","compatibility_profile"],"additionalProperties":true},
    "time_bounds":{"type":"object","required":["business_or_event_time","recorded_or_commit_time","ingestion_time"],"additionalProperties":true},
    "position_bounds":{"type":"object","required":["start","end","ordering_scope","finality"],"additionalProperties":true},
    "record_identity":{"type":"object","required":["population_digest","record_count","key_coverage"],"additionalProperties":true},
    "completeness":{"type":"object","required":["state","reconciliation_receipt_ref","known_residuals"],"properties":{"state":{"enum":["COMPLETE_FOR_DECLARED_SCOPE","PARTIAL_DECLARED","INCONCLUSIVE","INVALIDATED"]}},"additionalProperties":true},
    "deletions_and_corrections":{"type":"object","required":["represented","policy","residuals"],"additionalProperties":true},
    "authority_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "lineage":{"type":"object","required":["source_occurrence","access_surface","connector","plan","execution_receipts"],"additionalProperties":true},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "created_at":{"type":"string","format":"date-time"},
    "status":{"enum":["SEALED","PARTIAL","INVALIDATED","SUPERSEDED"]},
    "non_collapse":{"type":"array","minItems":5,"uniqueItems":true,"items":{"type":"string"}},
    "completion_claim":{"type":"boolean","const":false}
  }
}
