{
  "$id": "https://san.example/spec/provider-target/capability_class_id-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_class_id": {
      "pattern": "^[a-z][a-z0-9_.-]+$",
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "family": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "non_semantic_owner": {
      "const": true
    },
    "parent_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "required_surfaces": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "capability_class_id",
    "edition",
    "status",
    "family",
    "name",
    "definition",
    "required_surfaces",
    "non_semantic_owner",
    "evidence_refs"
  ],
  "title": "Provider-neutral capability class",
  "type": "object"
}
