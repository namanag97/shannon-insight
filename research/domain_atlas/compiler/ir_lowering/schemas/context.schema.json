{
  "$defs": {
    "id": {
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_:-]+)+$",
      "type": "string"
    },
    "refs": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "uniqueItems": true
    },
    "strings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "$ref": "#/$defs/id"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "excludes": {
      "type": "string"
    },
    "gaps": {
      "$ref": "#/$defs/strings"
    },
    "inbound_contracts": {
      "$ref": "#/$defs/strings"
    },
    "name": {
      "type": "string"
    },
    "outbound_contracts": {
      "$ref": "#/$defs/strings"
    },
    "owns": {
      "type": "string"
    },
    "source_refs": {
      "$ref": "#/$defs/refs"
    },
    "status": {
      "const": "candidate"
    }
  },
  "required": [
    "context_id",
    "edition",
    "status",
    "name",
    "owns",
    "excludes",
    "inbound_contracts",
    "outbound_contracts",
    "source_refs",
    "gaps"
  ],
  "title": "IR bounded context candidate",
  "type": "object"
}
