{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/spec/industry-foundation-evidence-claim-v1.schema.json",
  "title": "Reviewable evidence claim for the industry foundation",
  "type": "object",
  "required": [
    "record_id",
    "record_kind",
    "edition",
    "status",
    "claim_kind",
    "claim",
    "assertion_scope",
    "support",
    "inference",
    "defeaters",
    "review"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"},
    "record_kind": {"const": "evidence_claim"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "verified", "superseded", "rejected"]},
    "claim_kind": {"enum": ["normative", "descriptive", "completeness", "crosswalk", "design_inference", "limitation"]},
    "claim": {"type": "string", "minLength": 1},
    "assertion_scope": {"type": "string", "minLength": 1},
    "support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_ref", "locator", "support_type"],
        "properties": {
          "source_ref": {"type": "string"},
          "locator": {"type": "string", "minLength": 1},
          "support_type": {"enum": ["direct", "corroborating", "methodological"]}
        },
        "additionalProperties": false
      }
    },
    "inference": {"type": ["string", "null"]},
    "defeaters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "review": {
      "type": "object",
      "required": ["reviewer", "reviewed_at"],
      "properties": {
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
