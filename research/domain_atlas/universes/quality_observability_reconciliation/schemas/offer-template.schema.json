{
  "$id": "https://shannon-insight.local/schemas/qor/offer-template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edition": {
      "type": "integer"
    },
    "guarantees": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "offer_id": {
      "pattern": "^qor\\.offer_template\\.",
      "type": "string"
    },
    "offered_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "operation_profiles": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_context": {
      "minLength": 1,
      "type": "string"
    },
    "provider_class": {
      "minLength": 1,
      "type": "string"
    },
    "qualification_receipts_required": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source_refs": {
      "items": {
        "pattern": "^qor\\.src\\.",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "researched_candidate_not_adjudicated"
    },
    "unsupported_semantics": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "offer_id",
    "edition",
    "status",
    "provider_class",
    "owner_context",
    "offered_capabilities",
    "operation_profiles",
    "guarantees",
    "unsupported_semantics",
    "qualification_receipts_required",
    "source_refs"
  ],
  "title": "Quality capability offer template",
  "type": "object"
}
