{
  "$id": "https://san.local/domain-atlas/security-privacy-trust/sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_supported": {
      "minLength": 1,
      "type": "string"
    },
    "cross_platform_map": {
      "additionalProperties": false,
      "properties": {
        "consumption": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "governance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "persistence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pipelines": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "runtime": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_occurrences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "types_shapes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "source_occurrences",
        "types_shapes",
        "pipelines",
        "persistence",
        "runtime",
        "governance",
        "lineage",
        "consumption"
      ],
      "type": "object"
    },
    "domains": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "occurrences": {
      "items": {
        "properties": {
          "concept": {
            "minLength": 1,
            "type": "string"
          },
          "registry": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "concept",
          "registry"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "minLength": 3,
      "type": "string"
    },
    "source_kind": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "sourced_candidate",
        "open_candidate_gap"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "claim_supported",
    "domains",
    "edition",
    "occurrences",
    "publisher",
    "source_id",
    "source_kind",
    "status",
    "title",
    "url"
  ],
  "title": "Security Privacy Trust sources candidate",
  "type": "object"
}
