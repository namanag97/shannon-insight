  "pipeline_laws": [
    "source occurrence selection precedes source admission",
    "raw observation != admitted fact",
    "admitted fact != derived relation",
    "derived relation != analytical method result",
    "method result != application signal",
    "application signal != evidenced finding",
    "evidenced finding != authorized decision or effect",
    "persisted snapshot != source-system truth",
    "experience projection cannot mint or mutate upstream facts",
    "same Python process does not collapse stage ownership"
