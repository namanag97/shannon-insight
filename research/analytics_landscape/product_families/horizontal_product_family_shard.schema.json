{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shannon-insight.local/schemas/horizontal-product-family-shard-v1.json",
  "title": "Horizontal analytics product-family research shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "families"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "format": "date"},
    "families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sovereign_question", "negative_charter", "organizations", "research", "required_product_surfaces", "coverage"],
      "properties": {
        "id": {"type": "string", "pattern": "^hpf_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 3},
        "sovereign_question": {"type": "string", "minLength": 20},
        "negative_charter": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "organizations": {"type": "array", "minItems": 25, "items": {"$ref": "#/$defs/org"}},
        "research": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/research"}},
        "required_product_surfaces": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization_floor", "organization_count", "company_floor", "company_count", "research_floor", "research_count", "status"],
          "properties": {
            "organization_floor": {"type": "integer", "minimum": 25},
            "organization_count": {"type": "integer", "minimum": 25},
            "company_floor": {"type": "integer", "minimum": 25},
            "company_count": {"type": "integer", "minimum": 25},
            "research_floor": {"type": "integer", "minimum": 8},
            "research_count": {"type": "integer", "minimum": 8},
            "status": {"enum": ["seeded", "review_candidate", "reviewed", "stale"]}
          }
        }
      }
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "organization_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^org_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "organization_kind": {"enum": ["company", "nonprofit_project"]}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "kind", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^ref_[a-z0-9_]+$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "kind": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100}
      }
    }
  }
}
