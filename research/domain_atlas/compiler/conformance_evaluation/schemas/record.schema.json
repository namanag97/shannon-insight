{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]+$",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "edition",
    "status"
  ],
  "type": "object"
}
