{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "decision_points": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "domain_vision": {
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "inside": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "neighbor_context_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "outside": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "candidate"
    },
    "ubiquitous_terms": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "context_id",
    "edition",
    "status",
    "name",
    "domain_vision",
    "inside",
    "outside",
    "ubiquitous_terms",
    "invariants",
    "decision_points",
    "neighbor_context_refs",
    "evidence_refs",
    "gaps"
  ],
  "title": "Query/compute/kernel bounded-context candidate",
  "type": "object"
}
