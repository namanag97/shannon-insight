{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shannon-insight.local/schemas/code-intelligence-binding.schema.json",
  "title": "Code-intelligence application binding records",
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "minItems": 1, "uniqueItems": true},
    "product": {
      "type": "object",
      "required": ["product_id", "name", "edition", "status", "product_kind", "sovereign_question", "users", "jobs", "owned_artifacts", "commands", "queries", "events", "state_machine", "invariants", "refusals", "authority_model", "negative_charter", "non_collapse_laws", "falsification_tests", "qualification", "completion_claim"],
      "properties": {
        "product_id": {"const": "application_product.software_codebase_intelligence"},
        "product_kind": {"const": "application_domain_analytical_product"},
        "implementation_language": {"const": "python"},
        "completion_claim": {"const": false},
        "users": {"$ref": "#/$defs/stringList"},
        "jobs": {"$ref": "#/$defs/stringList"},
        "commands": {"$ref": "#/$defs/stringList"},
        "queries": {"$ref": "#/$defs/stringList"},
        "events": {"$ref": "#/$defs/stringList"},
        "invariants": {"$ref": "#/$defs/stringList"},
        "refusals": {"$ref": "#/$defs/stringList"},
        "negative_charter": {"$ref": "#/$defs/stringList"},
        "non_collapse_laws": {"$ref": "#/$defs/stringList"},
        "falsification_tests": {"$ref": "#/$defs/stringList"},
        "owned_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact", "owner", "meaning"],
            "properties": {"artifact": {"$ref": "#/$defs/nonEmptyString"}, "owner": {"const": "application_product.software_codebase_intelligence"}, "meaning": {"$ref": "#/$defs/nonEmptyString"}},
            "additionalProperties": false
          }
        },
        "qualification": {
          "type": "object",
          "required": ["semantic_ratified", "implementation_qualified", "independent_appraisal", "portable", "executed_vertical_acceptance", "build_ready", "ratified"],
          "additionalProperties": {"const": false}
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["component_id", "path", "role", "ownership_kind", "semantic_owner", "imports", "cannot_own", "implementation_language", "status", "qualification_claim", "completion_claim"],
      "properties": {
        "component_id": {"pattern": "^component\\.code_intelligence\\."},
        "path": {"pattern": "^src/shannon_insight/"},
        "implementation_language": {"const": "python"},
        "qualification_claim": {"const": false},
        "completion_claim": {"const": false}
      },
      "additionalProperties": true
    },
    "library": {
      "type": "object",
      "required": ["library_id", "role", "types", "operations", "decisions", "invariants", "refusals", "dependencies", "compiler_binding", "compatibility_rule", "evolution_rule", "resource_failure_rule", "qualification_status", "completion_claim"],
      "properties": {
        "library_id": {"pattern": "^library\\.code_intelligence\\."},
        "types": {"$ref": "#/$defs/stringList"},
        "operations": {"$ref": "#/$defs/stringList"},
        "decisions": {"$ref": "#/$defs/stringList"},
        "invariants": {"$ref": "#/$defs/stringList"},
        "refusals": {"$ref": "#/$defs/stringList"},
        "dependencies": {"$ref": "#/$defs/stringList"},
        "completion_claim": {"const": false}
      },
      "additionalProperties": true
    },
    "researchPython": {
      "type": "object",
      "required": ["python_file_id", "path", "role", "classification_basis", "authority", "production_runtime", "semantic_authority", "provider_qualification", "build_ready_claim", "completion_claim"],
      "properties": {
        "path": {"pattern": "^research/.+\\.py$"},
        "authority": {"const": "research_workbench_only"},
        "production_runtime": {"const": false},
        "semantic_authority": {"const": false},
        "provider_qualification": {"const": false},
        "build_ready_claim": {"const": false},
        "completion_claim": {"const": false}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "role", "locator", "claim", "does_not_prove"],
      "properties": {"evidence_id": {"pattern": "^evidence\\."}, "role": {"enum": ["architecture", "standard", "product_boundary_evidence", "empirical_validation", "governance", "human_factors", "algorithm", "foundational_theory"]}, "does_not_prove": {"$ref": "#/$defs/stringList"}},
      "additionalProperties": false
    }
  }
}
