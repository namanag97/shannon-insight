{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.example/domain-atlas/data-modality-gap-audit/audit-assertion.schema.json",
  "type": "object",
  "required": ["assertion_id", "assertion_kind", "subject_family_id", "claim", "disposition", "canonical_refs", "evidence_refs", "falsifier_or_closure", "priority"],
  "properties": {
    "assertion_id": {"type": "string", "pattern": "^ASSERT-"},
    "assertion_kind": {"enum": ["invalid_inference", "coverage_boundary", "representation_layer_confusion"]},
    "subject_family_id": {"type": "string", "pattern": "^fam\\."},
    "claim": {"type": "string", "minLength": 15},
    "disposition": {"type": "string"},
    "canonical_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "falsifier_or_closure": {"type": "string", "minLength": 15},
    "priority": {"enum": ["low", "medium", "high", "critical"]}
  },
  "additionalProperties": false
}
