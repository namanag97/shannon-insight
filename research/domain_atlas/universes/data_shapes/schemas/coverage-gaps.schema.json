{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/data-shape-coverage-gaps-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "edition", "status", "completeness_claim", "gaps", "forbidden_shortcuts"],
  "properties": {
    "registry_id": {"const": "san.domain-atlas.data-shapes.coverage-gaps"},
    "edition": {"type": "integer", "minimum": 1},
    "status": {"const": "active_research_gaps"},
    "completeness_claim": {"type": "string", "minLength": 20},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "area", "severity", "description", "closure_evidence"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^DSG-[0-9]{3}$"},
          "area": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string", "minLength": 20},
          "closure_evidence": {"type": "string", "minLength": 20}
        }
      }
    },
    "forbidden_shortcuts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
