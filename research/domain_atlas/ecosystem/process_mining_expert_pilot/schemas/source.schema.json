{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/process-mining-expert-source-v0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "url", "publisher_or_owner", "source_kind", "is_primary_evidence", "retrieved_on"],
  "properties": {
    "id": {"type": "string", "pattern": "^src\\."},
    "title": {"type": "string", "minLength": 3},
    "url": {"type": "string", "pattern": "^https://"},
    "publisher_or_owner": {"type": "string", "minLength": 2},
    "source_kind": {"type": "string", "minLength": 2},
    "is_primary_evidence": {"type": "boolean"},
    "retrieved_on": {"type": "string", "format": "date"}
  }
}
