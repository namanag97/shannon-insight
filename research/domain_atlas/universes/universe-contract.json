  "extension_universes": [
    {
      "universe_id": "model_agent_extension",
      "unit": "versioned model or agent capability contract operating through deterministic typed ports, policies and effect controls",
      "not_a_unit": ["AI prefix on an existing domain", "unbounded autonomous app", "model output treated as fact or authority", "replacement for deterministic compiler work"],
      "dependency_direction": "extension_depends_on_core_only",
      "required_surfaces": ["task_contract", "model_artifact_and_edition", "input_output_schema", "context_and_tool_scope", "nondeterminism", "evaluation", "uncertainty", "security_privacy", "prompt_or_policy_identity", "resource_and_cost_budget", "human_and_machine_authority", "effect_intent", "validation", "fallback", "audit_receipts", "monitoring", "invalidation"]
    }
