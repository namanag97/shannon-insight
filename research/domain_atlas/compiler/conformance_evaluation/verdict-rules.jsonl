{"condition": "execution exceeds declared budget", "edition": 1, "id": "verdict.ce.timeout", "kind": "verdict_rule", "result": "inconclusive", "retry_effect": "new attempt is additional evidence", "status": "candidate_research_record"}
{"condition": "same scoped execution produces inconsistent outcomes", "edition": 1, "id": "verdict.ce.flaky", "kind": "verdict_rule", "result": "inconclusive", "retry_effect": "record every attempt and classify nondeterminism", "status": "candidate_research_record"}
{"condition": "sample size/power is below declared requirement", "edition": 1, "id": "verdict.ce.underpowered", "kind": "verdict_rule", "result": "inconclusive", "retry_effect": "increase justified sample; do not reinterpret", "status": "candidate_research_record"}
{"condition": "evidence exceeds time or event freshness", "edition": 1, "id": "verdict.ce.stale", "kind": "verdict_rule", "result": "invalid", "retry_effect": "requalify", "status": "candidate_research_record"}
{"condition": "artifact, config, target, oracle or population identity mismatches", "edition": 1, "id": "verdict.ce.mismatch", "kind": "verdict_rule", "result": "invalid", "retry_effect": "execute exact scope", "status": "candidate_research_record"}
