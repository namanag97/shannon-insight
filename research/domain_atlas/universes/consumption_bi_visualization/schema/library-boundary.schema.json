{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "contributes_to_context_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "determinism_posture": {
      "minLength": 1,
      "type": "string"
    },
    "edition": {
      "minimum": 1,
      "type": "integer"
    },
    "effect_boundary": {
      "enum": [
        "pure_no_io",
        "pure_effect_intents",
        "effectful_runtime"
      ]
    },
    "error_contracts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "forbidden_ownership": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "input_contracts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "input_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "laws": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "layer": {
      "enum": [
        "pure",
        "runtime"
      ]
    },
    "library_id": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "effect_intent_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_types": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "operation_ref": {
            "minLength": 1,
            "type": "string"
          },
          "output_type": {
            "minLength": 1,
            "type": "string"
          },
          "purity": {
            "enum": [
              "pure",
              "effectful_explicit",
              "unresolved_refuse"
            ]
          },
          "receipt_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "refusal_types": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operation_ref",
          "name",
          "input_types",
          "output_type",
          "purity",
          "effect_intent_type",
          "receipt_type",
          "refusal_types"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "oracles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "output_contracts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "output_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "public_traits": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "public_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "responsibility": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_owner_ref": {
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "status": {
      "const": "candidate"
    }
  },
  "required": [
    "library_id",
    "edition",
    "status",
    "layer",
    "responsibility",
    "contributes_to_context_refs",
    "capability_refs",
    "input_contracts",
    "output_contracts",
    "forbidden_ownership",
    "determinism_posture",
    "evidence_refs"
  ],
  "title": "Consumption library boundary",
  "type": "object"
}
