{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["edge_id", "from_id", "to_id", "relation", "claim_state", "evidence_refs", "evidence_scope", "limitations"],
  "properties": {
    "edge_id": {"type": "string", "pattern": "^edge\\."},
    "from_id": {"type": "string"},
    "to_id": {"type": "string"},
    "relation": {"enum": ["authored", "portfolio_routed_to", "content_supports", "implemented", "developed_methodology", "performed_formal_analysis", "validated", "maintains", "advocated", "replicated", "criticized"]},
    "claim_state": {"type": "string"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
